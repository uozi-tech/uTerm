<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UTermBundleIDBase</key>
	<string>$(UTERM_BUNDLE_ID)</string>
	<key>UTermRelayReleaseURL</key>
	<string>$(UTERM_RELAY_RELEASE_URL)</string>
	<!-- 系统设置（辅助功能等列表）、本地网络授权框里显示的名字在 zh-Hans.lproj / en.lproj 的 InfoPlist.strings 里给。
	     这里的值必须等于包的文件名（PRODUCT_NAME）：未本地化的 CFBundleDisplayName 与文件名不一致时，系统不采用本地化
	     名字，只显示文件名（2026-11-14 实测）。CFBundleName 构建时也会被换成 PRODUCT_NAME。 -->
	<key>CFBundleDisplayName</key>
	<string>uTermRemoteHost</string>
	<key>CFBundleName</key>
	<string>uTermRemoteHost</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSAppNapIsDisabled</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>uTerm 让配对过的手机和 Mac 在局域网里远程控制这台 Mac 上的终端和屏幕。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_uterm-remote._tcp</string>
	</array>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>配对过的设备经 uTerm 远程读写这台 Mac 上的文件。</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>配对过的设备经 uTerm 远程读写这台 Mac 上的文件。</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>配对过的设备经 uTerm 远程读写这台 Mac 上的文件。</string>
</dict>
</plist>
