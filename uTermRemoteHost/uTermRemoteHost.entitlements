<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 沙盒 App 用 SMAppService 注册的 agent 必须也带沙盒（macOS 14.2 起），见 docs/remote-control-daemon-plan.md §14。
	     读写用户文件、跑命令交给包内无沙盒的 uTermShellAgent.xpc。 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- 远程桌面只看一个窗口时，用辅助功能接口把那个窗口提到最前（RemoteDesktopWindows.raise）。沙盒默认拦着
	     别的进程的辅助功能端口，没有这一条时读窗口列表报 -25204（2026-11-17 探针）。授权仍是「辅助功能」那一项。 -->
	<key>com.apple.security.temporary-exception.mach-lookup.local-name</key>
	<array>
		<string>com.apple.axserver</string>
	</array>
</dict>
</plist>
