<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>uTerm 使用局域网在 Mac 与 iPhone、iPad 之间同步设置，并让配对过的手机远程控制这台 Mac 上的终端和屏幕。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_uterm-sync._tcp</string>
		<string>_uterm-remote._tcp</string>
		<string>_uterm-group._tcp</string>
	</array>
	<key>SUFeedURL</key>
	<string>$(UTERM_SU_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(UTERM_SU_PUBLIC_ED_KEY)</string>
	<key>UTermRelayReleaseURL</key>
	<string>$(UTERM_RELAY_RELEASE_URL)</string>
	<key>SUScheduledCheckInterval</key>
	<integer>14400</integer>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.uozi.uTerm.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>uterm</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.uozi.uterm.pane-id</string>
			<key>UTTypeDescription</key>
			<string>uTerm pane drag identifier</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.uozi.uterm.tab-id</string>
			<key>UTTypeDescription</key>
			<string>uTerm tab drag identifier</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.uozi.uterm.file-buffer-id</string>
			<key>UTTypeDescription</key>
			<string>uTerm file buffer drag identifier</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.uozi.uterm.remote-file</string>
			<key>UTTypeDescription</key>
			<string>uTerm remote file drag identifier</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
