        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモート操作のプロトコルバージョンに互換性がありません（相手 %1$@、このデバイス %2$@）。両端のuTermを同じバージョンにアップデートしてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 제어 프로토콜 버전이 호환되지 않습니다(상대 %1$@, 이 기기 %2$@). 양쪽의 uTerm을 같은 버전으로 업데이트하십시오"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
