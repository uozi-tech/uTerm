            "value" : "원격 모델 제공자는 HTTPS를 사용해야 합니다. HTTP는 localhost, 127.0.0.0/8, ::1만 사용할 수 있습니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
