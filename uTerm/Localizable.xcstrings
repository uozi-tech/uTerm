          }
        }
      }
    },
    "远程转发" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Forwarding"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートフォワーディング"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 포워딩"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端轉送"
          }
        }
      }
    },
    "远端在 %@ 处提前结束（传输期间文件被改了？）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The remote file ended early at %@ (was it changed during the transfer?)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートのファイルが %@ で途中で終わっています（転送中に変更された？）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 파일이 %@에서 일찍 끝났습니다(전송 중에 파일이 변경되었습니까?)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端在 %@ 處提前結束（傳輸期間檔案被改了？）"
          }
        }
      }
    },
    "远端存在 %@，说明有程序正在写这个数据库（或上次异常退出）。uTable 会把整个库下载到本地，改动后再整体传回；如果远端程序同时在写，双方的改动会互相覆盖，甚至损坏数据库。建议先停掉使用它的服务，或只做查看。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ exists on the remote, which means a program is writing to this database (or exited abnormally last time). uTable downloads the whole database locally and uploads it back in full after you make changes; if a remote program writes at the same time, the changes can overwrite each other or even corrupt the database. Stop the services that use it first, or only view it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートに %@ があります。このデータベースに書き込んでいるプログラムがある（または前回異常終了した）ことを示しています。uTable はデータベース全体をローカルにダウンロードし、変更後に丸ごと書き戻します。リモートのプログラムが同時に書き込んでいると、双方の変更が上書きし合ったり、データベースが破損したりするおそれがあります。先にこのデータベースを使っているサービスを停止するか、表示のみにすることをおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격에 %@이(가) 있습니다. 어떤 프로그램이 이 데이터베이스에 쓰고 있거나 지난번에 비정상 종료되었다는 뜻입니다. uTable은 데이터베이스 전체를 로컬로 다운로드하고 변경 후 통째로 다시 업로드합니다. 원격 프로그램이 동시에 쓰고 있으면 양쪽의 변경 사항이 서로 덮어쓰거나 데이터베이스가 손상될 수 있습니다. 먼저 이 데이터베이스를 사용하는 서비스를 중지하거나 보기만 하는 것이 좋습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端存在 %@，表示有程式正在寫入這個資料庫（或上次異常結束）。uTable 會把整個資料庫下載到本機，修改後再整體傳回；如果遠端程式同時在寫入，雙方的修改會互相覆蓋，甚至損壞資料庫。建議先停止使用它的服務，或只做檢視。"
          }
        }
      }
    },
    "连不上「%@」" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't connect to “%@”."
          }
