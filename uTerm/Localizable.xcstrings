    "远程模型服务必须使用 HTTPS；只有 localhost、127.0.0.0/8、::1 可以用 HTTP" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote model providers must use HTTPS; only localhost, 127.0.0.0/8, and ::1 can use HTTP"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートのモデルプロバイダは HTTPS を使用する必要があります。HTTP を使用できるのは localhost、127.0.0.0/8、::1 のみです"
          }
        },
        "ko" : {
          "stringUnit" : {
