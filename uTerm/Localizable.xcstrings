          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac이 이 로컬 네트워크에 없습니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
