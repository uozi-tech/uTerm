    "装在我 uTerm 里保存的主机「%@」上。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install it on the host “%@” saved in my uTerm."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私の uTerm に保存されているホスト「%@」にインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 uTerm에 저장된 호스트 ‘%@’에 설치하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝在我 uTerm 裡儲存的主機「%@」上。"
          }
        }
      }
    },
    "装好后用 utermctl relay import 把配置导入 uTerm，再用 utermctl relay check 测试；不通就按结果排查，直到测通。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After installing, use utermctl relay import to import the config into uTerm, then test it with utermctl relay check. If it fails, troubleshoot based on the result until the test passes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール後、utermctl relay import で設定を uTerm に読み込み、utermctl relay check でテストしてください。つながらなければ結果をもとに原因を調べ、テストが通るまで続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치 후 utermctl relay import로 설정을 uTerm에 가져온 다음 utermctl relay check로 테스트하세요. 연결되지 않으면 결과를 보고 문제를 해결해 통과할 때까지 진행하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝好後用 utermctl relay import 把設定匯入 uTerm，再用 utermctl relay check 測試；不通就按結果排查，直到測通。"
          }
        }
      }
    },
