        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスで SOCKS5 プロキシを開き、接続先はクライアントが必要に応じて選びます。ブラウザやツールからこのホスト経由で内部ネットワークにアクセスするときに使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 SOCKS5 프록시를 열고 클라이언트가 필요에 따라 대상을 선택합니다. 브라우저나 도구가 이 호스트를 거쳐 내부 네트워크에 접근할 때 사용합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
