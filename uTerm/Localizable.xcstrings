    "输入 Mac 上「设置 › 同步」中显示的 6 位配对码" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the 6-digit pairing code shown in Settings › Sync on the Mac"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac の「設定 › 同期」に表示される 6 桁のペアリングコードを入力"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac의 ‘설정 › 동기화’에 표시된 6자리 페어링 코드 입력"
          }
        },
        "zh-Hant" : {
