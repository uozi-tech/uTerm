    ".%@ 文件不是文本，无法预览。可以用本机应用打开（保存后自动上传回主机），或下载到本地。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".%@ files aren't text and can't be previewed. You can open it in an app on this Mac (it uploads back to the host when you save) or download it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".%@ ファイルはテキストではないため、プレビューできません。この Mac の App で開く（保存すると自動でホストにアップロードされます）か、ローカルにダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".%@ 파일은 텍스트가 아니어서 미리 볼 수 없습니다. 이 Mac의 앱으로 열거나(저장하면 호스트에 자동으로 업로드됨) 로컬로 다운로드할 수 있습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".%@ 檔案不是文字，無法預覽。可以用本機 App 打開（儲存後自動上傳回主機），或下載到本機。"
          }
        }
      }
    },
