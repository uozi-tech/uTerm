    "订阅后可以使用 uTerm 的全部功能。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscribe to use all of uTerm's features."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録すると uTerm のすべての機能を使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독하면 uTerm의 모든 기능을 사용할 수 있습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱後可以使用 uTerm 的全部功能。"
