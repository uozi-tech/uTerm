    "把它设为浏览器 / 系统的 SOCKS5 代理" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set this as the SOCKS5 proxy in your browser or system settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これをブラウザやシステムの SOCKS5 プロキシに設定します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
