        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはテスト用の uTerm です。リレーには接続せず、インストール済みの uTerm のリモート操作設定も読み書きしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
