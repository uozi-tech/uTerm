          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何指令執行前都要確認"
          }
        }
      }
    },
    "会在「%@」上下载、校验后替换并重启，新版本起不来会自动换回。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads and verifies the update on “%@”, then replaces and restarts the relay. If the new version fails to start, it switches back automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」上でダウンロードと検証を行ってから置き換えて再起動します。新しいバージョンが起動しない場合は自動的に元に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’에서 다운로드하고 검증한 후 교체하고 다시 시작합니다. 새 버전이 시작되지 않으면 자동으로 되돌립니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會在「%@」上下載、驗證後取代並重新啟動，新版本無法啟動時會自動換回。"
          }
        }
      }
    },
    "会在「%@」上下载新版本并重启中继。正在经中继的连接会断开几秒，之后自动重连。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will download the new version on “%@” and restart the relay. Connections going through the relay will drop for a few seconds, then reconnect automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」で新しいバージョンをダウンロードし、リレーを再起動します。リレーを経由している接続は数秒間切断され、その後自動的に再接続されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’에서 새 버전을 다운로드하고 릴레이를 다시 시작합니다. 릴레이를 거치는 연결은 몇 초간 끊어졌다가 자동으로 다시 연결됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會在「%@」上下載新版本並重新啟動中繼。正在經中繼的連線會中斷幾秒，之後自動重新連線。"
          }
        }
      }
    },
    "会话「%@」已经不在了（窗口关了？）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session “%@” no longer exists (was the window closed?)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション「%@」はもう存在しません（ウインドウが閉じられた？）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 ‘%@’이(가) 더 이상 없습니다(윈도우가 닫혔습니까?)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段「%@」已經不存在了（視窗關了？）"
          }
        }
      }
    },
    "会话「%@」的连接已断开，没有写进去" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session “%@” is disconnected; nothing was written."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション「%@」の接続が切断されているため、書き込まれませんでした"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 ‘%@’의 연결이 해제되어 쓰지 못했습니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段「%@」的連線已中斷，沒有寫入"
          }
        }
      }
    },
    "会话「%@」里没有用 `terminal open -H <主机> -- <命令>` 跑过命令，没有可等的结果。看屏幕用 terminal read。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No command was run in session “%@” with `terminal open -H <host> -- <command>`, so there's no result to wait for. Use terminal read to see the screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション「%@」では `terminal open -H <ホスト> -- <コマンド>` でコマンドを実行していないため、待つべき結果がありません。画面を見るには terminal read を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 ‘%@’에서 `terminal open -H <호스트> -- <명령>`으로 실행한 명령이 없어 기다릴 결과가 없습니다. 화면을 보려면 terminal read를 사용하십시오."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段「%@」裡沒有用 `terminal open -H <主機> -- <指令>` 執行過指令，沒有可等的結果。看螢幕請用 terminal read。"
          }
        }
      }
