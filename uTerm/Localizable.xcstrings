        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルール「%@」は自動開始がオンになっており、ユーザが常に動かしておきたいルールです。uTerm の画面でのみ削除できます"
          }
        },
        "ko" : {
