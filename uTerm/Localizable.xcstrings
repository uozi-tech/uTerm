    "本机终端未能在 %lld 秒内启动，原因见 Mac 上的本机终端窗口" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The local terminal didn’t start within %lld second. See the local terminal window on the Mac for details"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The local terminal didn’t start within %lld seconds. See the local terminal window on the Mac for details"
                }
              }
