          }
        }
      }
    },
    "配对其他 Mac…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair Another Mac…"
          }
        },
        "ja" : {
          "stringUnit" : {
