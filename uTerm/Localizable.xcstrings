    "命令运行中" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command running"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンド実行中"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
