    "首帧解码完（%@，解码 %@ ms；此前没收齐 %lld、等恢复帧跳过 %lld、解码失败 %lld、旧流丢弃 %lld）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First frame decoded (%1$@, decode %2$@ ms; before it: incomplete %3$lld, skipped awaiting recovery frame %4$lld, decode failed %5$lld, stale stream dropped %6$lld)"
          }
        },
        "ja" : {
