    "Mac 不在这个局域网里" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac isn’t on this local network."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
