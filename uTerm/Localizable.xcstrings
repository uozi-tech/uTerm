    "连续 %@ 秒没有任何输出，判定卡住" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No output at all for %@ seconds; treated as stuck"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 秒間まったく出力がないため、停止したと判断しました"
