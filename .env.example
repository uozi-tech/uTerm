OSS_BUCKET=example-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-region.aliyuncs.com
OSS_PREFIX=uTerm
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-webhook-key

# App Store Connect API key（仅 iOS / TestFlight 用）。
# 三个都填齐时，`make archive-mobile` / `export-mobile` / `upload-mobile` 三步都走 API key：
# 除了上传，`-allowProvisioningUpdates` 也用它去 App Store Connect 自动签发 Apple
# Distribution 证书与 App Store profile（Xcode 13+），所以本机不必登录任何 Apple ID。
# 留空则回退到 Xcode 已登录的 Apple ID——那个账号必须对 TEAM_ID 有 App Store Connect 权限，
# 否则 export 会报 `No Accounts` / `No signing certificate "iOS Distribution" found`。
# 在 App Store Connect → 用户和访问 → 集成 → App Store Connect API 里创建密钥，
# 下载 AuthKey_<KEY_ID>.p8（只能下一次），ASC_KEY_PATH 必须是**绝对路径**。
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
