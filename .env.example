OSS_BUCKET=example-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-region.aliyuncs.com
OSS_PREFIX=uTerm
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-webhook-key

# ---- App Store Connect API（iOS/TestFlight 发版用；归档、导出、上传、写 TestFlight 测试信息共用）----
# 创建：App Store Connect → 用户和访问 → 集成 → App Store Connect API → 团队密钥 → 生成，角色必须选「管理」(Admin)：
# App 管理角色的 key 能上传、能写 TestFlight 测试信息，但走 -allowProvisioningUpdates 导出时拿不到云托管的
# Apple Distribution 证书（报 Cloud signing permission error / FORBIDDEN_ERROR），且本团队生成 key 时不出现
# 「访问云管理的分发证书」复选框（2026-09-08 实测）。
# 生成后记下 Key ID（10 位）与页面顶部的 Issuer ID（UUID），下载 AuthKey_<KEY_ID>.p8（只能下载一次），
# 放到 ~/.appstoreconnect/private_keys/（目录已建好，600 权限），ASC_KEY_PATH 填绝对路径。
# 三个都填齐才生效；留空则回退到 Xcode 已登录的 Apple ID。
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
