OSS_BUCKET=example-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-region.aliyuncs.com
OSS_PREFIX=uTerm
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-webhook-key

# App Store Connect API key（可选，仅 iOS / TestFlight 上传用）。
# 三个都填齐时 `make upload-mobile` 走 API key 认证（适合无人值守）；
# 留空则回退到 Xcode 已登录的 Apple ID。
# 在 App Store Connect → 用户和访问 → 集成 → App Store Connect API 里创建密钥，
# 下载 AuthKey_<KEY_ID>.p8（只能下一次），ASC_KEY_PATH 必须是**绝对路径**。
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
