#!/usr/bin/env python3
"""uTerm 本机 IPC 客户端。

单一真值源：构建期的「Copy utermctl CLI and Skills」阶段把本文件拷进 uTerm.app 的
Contents/Resources/utermctl 与 Contents/Resources/Skills/uterm/bin/utermctl，技能目录与
~/.local/bin 都直接链到包内。包内两份与本文件逐字节一致，uTermTests/SkillDefinitionTests 会校验。

凭据永远不经过这里：密码 / 私钥 / 口令留在 uTerm 与钥匙串里，客户端只能按名字或
UUID 指一台**用户已保存**的主机。
"""
import argparse
import array
import concurrent.futures
import csv
import datetime
import fnmatch
import hashlib
import io
import json
import os
import plistlib
import re
import shlex
import socket
import subprocess
import sys
import threading
import time
import uuid

# ---------------------------------------------------------------------------
# 本地化：给人看的文字（帮助、报错、提示、表头）跟系统语言走。
#
# 源文是简体中文，`_("中文原文")` 按原文查下面的翻译表，zh-Hans 原样返回。带格式的一律用命名占位
# （`_("连接 {host} 失败").format(host=…)`），各语言可以调语序。命令名、参数名、JSON 字段名、
# code、退出码不翻译。脚本是单文件、被拷进 app 包，翻译表只能内嵌在这里。
#
# 语言：`UTERM_LANG`（zh-Hans / en / zh-Hant / ja / ko）> macOS 全局首选语言（AppleLanguages 里
# 第一个支持的；都不支持就是 en）> LC_ALL / LC_MESSAGES / LANG > en。第一次要出文字时探测一次。
# ---------------------------------------------------------------------------
ENV_LANG = "UTERM_LANG"
SOURCE_LANGUAGE = "zh-Hans"
# 翻译表里每条译文元组的顺序。
TRANSLATED_LANGUAGES = ("en", "zh-Hant", "ja", "ko")
_language = None


def normalize_language(tag, fallback="en"):
    """`zh-Hans-CN` / `zh_TW.UTF-8` / `ja-JP` → 支持的语言之一。

    空的、C / POSIX 回 None；认得出但不支持的语言回 `fallback`。"""
    tag = (tag or "").strip().split(".", 1)[0].split("@", 1)[0].replace("_", "-")
    if not tag or tag.upper() in ("C", "POSIX"):
        return None
    parts = tag.lower().split("-")
    if parts[0] == "zh":
        if "hans" in parts:
            return "zh-Hans"
        if "hant" in parts or any(part in ("tw", "hk", "mo") for part in parts[1:]):
            return "zh-Hant"
        return "zh-Hans"
    if parts[0] in ("en", "ja", "ko"):
        return parts[0]
    return fallback


def apple_languages():
    """macOS 的全局首选语言列表；读不到回 []。

    先直接读偏好 plist（约 1 ms），读不到才起 `defaults`（几十毫秒，1 秒超时）。"""
    if sys.platform != "darwin":
        return []
    for candidate in ("~/Library/Preferences/.GlobalPreferences.plist",
                      "/Library/Preferences/.GlobalPreferences.plist"):
        try:
            with open(os.path.expanduser(candidate), "rb") as handle:
                value = plistlib.load(handle).get("AppleLanguages")
        except (OSError, ValueError, plistlib.InvalidFileException):
            continue
        if isinstance(value, list) and value:
            return [item for item in value if isinstance(item, str)]
    try:
        output = subprocess.run(["/usr/bin/defaults", "read", "-g", "AppleLanguages"],
                                stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                timeout=1).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    # 输出形如 `(\n    "zh-Hans-CN",\n    en\n)`。
    return re.findall(r"^\s*\"?([A-Za-z][A-Za-z0-9_-]*)\"?,?\s*$", output, re.MULTILINE)


def detect_language():
    explicit = os.environ.get(ENV_LANG)
    if explicit and explicit.strip():
        return normalize_language(explicit) or "en"
    preferred = apple_languages()
    if preferred:
        for tag in preferred:
            found = normalize_language(tag, fallback=None)
            if found:
                return found
        return "en"
    for name in ("LC_ALL", "LC_MESSAGES", "LANG"):
        found = normalize_language(os.environ.get(name))
        if found:
            return found
    return "en"


def current_language():
    global _language
    if _language is None:
        _language = detect_language()
    return _language


def _(text):
    """按当前语言取 `text`（简体中文原文）的译文；zh-Hans 或表里没有时原样返回。"""
    language = current_language()
    if language == SOURCE_LANGUAGE:
        return text
    translations = TRANSLATIONS.get(text)
    if translations is None:
        return text
    return translations[TRANSLATED_LANGUAGES.index(language)]


