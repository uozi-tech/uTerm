    "\n-- 内容不完整：读取期间远端文件变大了": (
        "\n-- Content incomplete: the remote file grew while it was being read",
        "\n-- 內容不完整：讀取期間遠端檔案變大了",
        "\n-- 内容が不完全です：読み取り中にリモートのファイルが大きくなりました",
        "\n-- 내용이 불완전합니다: 읽는 동안 원격 파일이 커졌습니다"),
    "-- {path} 不是 UTF-8 文本（{bytes} 字节）：用 `sftp get` 下载后本地处理": (
        "-- {path} isn't UTF-8 text ({bytes} bytes): download it with `sftp get` and handle it locally",
        "-- {path} 不是 UTF-8 文字（{bytes} 位元組）：用 `sftp get` 下載後在本機處理",
        "-- {path} は UTF-8 テキストではありません（{bytes} バイト）：`sftp get` でダウンロードしてローカルで処理してください",
        "-- {path}은(는) UTF-8 텍스트가 아닙니다({bytes}바이트): `sftp get`으로 다운로드해 로컬에서 처리하세요"),
    "\n-- 读屏已截断": (
        "\n-- Screen read truncated",
        "\n-- 讀取畫面已截斷",
        "\n-- 画面の読み取りを切り詰めました",
        "\n-- 화면 읽기가 잘렸습니다"),
}


ENV_SOCKET = "UTERM_CONTROL_SOCKET"
# uTerm 开本机终端时写进 shell 环境的终端编号（见 `mac_target`）。
ENV_SESSION = "UTERM_SESSION_ID"
OFFICIAL_BUNDLE_ID = "com.uozi.uTerm"


def _bundle_id():
    """uTerm 的 bundle id：UTERM_BUNDLE_ID 优先，其次读自己所在 .app 的 Info.plist（用自己团队签的构建会换
    bundle id 前缀，沙盒容器路径跟着变），都没有就是正式版。"""
    explicit = os.environ.get("UTERM_BUNDLE_ID", "").strip()
    if explicit:
        return explicit
    path = os.path.realpath(__file__)
    while path and path != os.path.dirname(path):
        if path.endswith(".app"):
            try:
                with open(os.path.join(path, "Contents", "Info.plist"), "rb") as handle:
                    value = plistlib.load(handle).get("CFBundleIdentifier")
                if isinstance(value, str) and value:
                    return value
            except (OSError, plistlib.InvalidFileException, ValueError):
                pass
            break
        path = os.path.dirname(path)
    return OFFICIAL_BUNDLE_ID


BUNDLE_ID = _bundle_id()
ON_DEMAND_KEY = "background.allowOnDemandLaunch"
CONTROL_ENABLED_KEY = "control.enabled"
PREFERENCE_CANDIDATES = [
    f"~/Library/Containers/{BUNDLE_ID}/Data/Library/Preferences/{BUNDLE_ID}.plist",
    f"~/Library/Preferences/{BUNDLE_ID}.plist",
]

# macOS 端 Debug 与 Release 都开沙盒，socket 只落在容器里。顺序与 uTerm 的
# `ControlProtocol.socketURL(applicationSupport:temporaryDirectory:)` 一致：默认在
# Application Support 下；那条路径超过 sun_path 上限（用户名超过 10 个字符）时 uTerm
# 改到容器的 Data/tmp/。最后一条是给「万一有人跑不带沙盒的构建」留的，成本为零。
SOCKET_CANDIDATES = [
    f"~/Library/Containers/{BUNDLE_ID}/Data/Library/Application Support/uTerm/control.sock",
    f"~/Library/Containers/{BUNDLE_ID}/Data/tmp/control.sock",
    "~/Library/Application Support/uTerm/control.sock",
]
# sockaddr_un.sun_path 104 字节，要给结尾 NUL 留 1 字节。
MAX_SOCKET_PATH_BYTES = 103

# `sftp get` / `sftp put` 让 uTerm 开几条 SFTP 通道并行搬（ControlProtocol 的
# defaultTransferChannels / maxTransferChannels）。实测 50 ms RTT 下 8–16 路是顶，
# 再多只会更慢，所以封顶 16。
DEFAULT_PARALLEL = 8
MAX_PARALLEL = 16

# 传输失败（连接断了之类）自动续传 2 次，只补缺的区间；仍失败就报错并留下续传状态。
RETRY_DELAYS = (0.5, 1.0)
# 服务端槽位满是**排队问题不是错误**，值得更有耐心：传输槽位被别的传输占满时，可能要
# 等其中一个跑完才空出来。退避到 4 秒封顶，前后约 1 分钟才放弃。
BUSY_RETRY_DELAYS = (0.5, 1.0, 2.0) + (4.0,) * 15
BUSY_CODES = frozenset(["server_busy", "empty_response"])

# 续传状态 sidecar（见 TransferState）与 get 的半成品后缀。v2 记的是已完成区间。
SIDECAR_SUFFIX = ".utermctl-transfer.json"
SIDECAR_VERSION = 2
PART_SUFFIX = ".part"

# 自测专用：指向一个文件时，重试退避只往里记一行秒数、不真的睡。
SLEEP_TRACE = os.environ.get("UTERMCTL_SLEEP_TRACE")

# 远端算 sha256：两个工具挑一个，都没有就跳过校验（不算失败）。
# `timeoutSeconds` 是**静默**超时，而 sha256sum 在算完之前一个字节都不输出 —— 大文件
# 要给足，否则算到一半就被当成卡死杀掉。取协议封顶。
REMOTE_SHA256_TIMEOUT = 1800
# 不小于这个大小的传输默认做 sha256 校验（见 verify_pair）。
VERIFY_MIN_BYTES = 8 * 1024 * 1024

# 等响应时 socket 的**静默**超时（秒）：uTerm 处理请求期间每 10 秒写一个 `\n` 心跳，
# 连续这么久一个字节都没收到，说明 uTerm 本身卡住了（不是命令慢）。命令 / 传输自己
# 跑多久由服务端的看门狗管，客户端不再需要猜「最长的命令要多久」。
# `UTERMCTL_IDLE_TIMEOUT` 只给自测用。
CLIENT_IDLE_TIMEOUT = float(os.environ.get("UTERMCTL_IDLE_TIMEOUT") or 60)
SHA256_RE = re.compile(r"\b([0-9a-fA-F]{64})\b")

FORMATS = ["json", "table", "csv"]

# 本地判定（服务端不会发出这几个码）
CODE_NOT_RUNNING = "uterm_not_running"
CODE_SOCKET_STALE = "uterm_socket_stale"
CODE_SOCKET_PATH_TOO_LONG = "socket_path_too_long"

# code → 退出码。技能文档里的错误码总表与这张表一一对应。
EXIT_OK = 0
EXIT_OTHER = 1
EXIT_LOCAL = 2       # 连不上 uTerm，或客户端自己的前置检查没过
EXIT_GATED = 3       # 门禁：两个开关 / 仅 SFTP 主机
EXIT_NOT_FOUND = 4   # 主机 / 规则 / 会话 / 文件找不到或有歧义
EXIT_REMOTE = 5      # 建连、认证、主机密钥、转发失败（run-many 全失败也算这一档）
EXIT_TIMEOUT = 6     # 超时
EXIT_PARTIAL = 7     # run-many / quick-run：有的主机成了、有的没成


def socket_paths():
    override = os.environ.get(ENV_SOCKET)
    if override:
        return [os.path.expanduser(override)]
    return [os.path.expanduser(p) for p in SOCKET_CANDIDATES]


def socket_path_too_long_response(request, paths, launch_error):
    """路径长度才是真正原因时给出 `socket_path_too_long`，否则返回 None。

    用户名超过 10 个字符时默认位置放不进 sun_path，uTerm 改用容器的 Data/tmp/（第二条候选）：
    - 第二条也放不下（用户名 40 个字符以上）：接口一定起不来，不管开关怎么设。
    - 第二条放得下却连不上，而 uTerm 确实被拉起来了（没被开关拒绝，只是接口没就绪）：
      装的是 2.1.6 及更早的版本，它不会改用短路径，接口在这台机器上起不来。
    被开关拒绝时照旧报开关的原因。显式指定了 UTERM_CONTROL_SOCKET 时不判。
    """
    if os.environ.get(ENV_SOCKET) or len(paths) < 2:
        return None
    primary, fallback = paths[0], paths[1]
    primary_bytes = len(primary.encode("utf-8"))
    if primary_bytes <= MAX_SOCKET_PATH_BYTES:
        return None
    if len(fallback.encode("utf-8")) > MAX_SOCKET_PATH_BYTES:
        message = _("macOS 用户名过长，uTerm 的 socket 路径连备用的短路径都超过系统上限 {limit} 字节（{path}），"
                    "命令行接口无法启动。").format(limit=MAX_SOCKET_PATH_BYTES, path=fallback)
    elif launch_error in (None, LAUNCH_NOT_READY_MESSAGE):
        message = _("macOS 用户名过长，uTerm 默认的 socket 路径（{bytes} 字节）超过系统上限 {limit} 字节：{path}。"
                    "uTerm 2.1.6 及更早的版本在这样的账户上无法启动命令行接口，"
                    "请把 uTerm 更新到最新版本（新版本会自动改用更短的路径）。"
                    ).format(bytes=primary_bytes, limit=MAX_SOCKET_PATH_BYTES, path=primary)
    else:
        return None
    return {"id": request.get("id"), "ok": False, "code": CODE_SOCKET_PATH_TOO_LONG, "message": message}


def preference_value(key):
    """读 uTerm 的一个布尔设置：True / False；读不到时返回 None（未知）。

    macOS 27 起，没给完全磁盘访问权限的进程读不了 uTerm 沙盒容器里的偏好 plist
    （EPERM）。这时不能当成「关」—— 交给 uTerm 自己按设置把关（见 start_background_and_wait）。
    """
    unreadable = False
    for candidate in PREFERENCE_CANDIDATES:
        path = os.path.expanduser(candidate)
        try:
            with open(path, "rb") as stream:
                value = plistlib.load(stream).get(key)
        except PermissionError:
            unreadable = True
            continue
        except (OSError, ValueError, plistlib.InvalidFileException):
            continue
        if value is not None:
            return bool(value)
    return None if unreadable else False


def on_demand_launch_allowed():
    return preference_value(ON_DEMAND_KEY)


def owning_app_bundle():
    path = os.path.realpath(__file__)
    while path and path != os.path.dirname(path):
        if path.endswith(".app"):
            return path
        path = os.path.dirname(path)
    return None


def launch_command():
    target = ["-a", owning_app_bundle()] if owning_app_bundle() else ["-b", BUNDLE_ID]
    # -W：等 uTerm 进程退出才返回。uTerm 按设置拒绝按需启动时会立刻退出，靠它区分
    # 「被拒绝」与「还在起」；接口就绪后这个等待进程直接结束掉，不影响 uTerm。
    return (["/usr/bin/open", "-gjW"] + target
            + ["--args", "--background", "--launch-source", "cli"])


LAUNCH_NOT_READY_MESSAGE = _("已请求后台启动 uTerm，但接口在 10 秒内没有就绪。若 uTerm 本来就在运行，"
                              "确认设置 ▸ 命令行与技能 里已打开「启用命令行接口」。")


def start_background_and_wait():
    # 读得到设置就先在本地拦下，报得准、也不白起一次进程；读不到（None）照样请求启动，
    # uTerm 收到 `--launch-source cli` 会自己检查这两项，不满足就立刻退出。
    if on_demand_launch_allowed() is False:
        return False, _("uTerm 未运行，且设置中没有允许 CLI 按需启动。用户在 uTerm 设置 ▸ 命令行与技能 里"
                        "打开「允许 CLI 按需启动」之后，utermctl 会自己在后台把它起起来。")
    if preference_value(CONTROL_ENABLED_KEY) is False:
        return False, _("uTerm 命令行接口未启用；按需启动设置不会绕过接口门禁。")
    try:
        launcher = subprocess.Popen(
            launch_command(), stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    except OSError as error:
        return False, _("无法唤起 uTerm 后台实例：{error}").format(error=error)

    try:
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            for path in socket_paths():
                if not os.path.exists(path):
                    continue
                try:
                    exchange(path, {"id": str(uuid.uuid4()), "action": "ping"})
                    # 能回话就算就绪；门禁类错误留给真正的业务请求去报。
                    return True, None
                except (ConnectionRefusedError, OSError):
                    pass
            code = launcher.poll()
            if code is not None:
                if code != 0:
                    return False, _("无法唤起 uTerm 后台实例：{error}").format(
                        error=launcher.stderr.read().strip())
                return False, _("uTerm 拒绝了按需启动：需要在 uTerm 设置 ▸ 命令行与技能 里同时打开"
                                "「允许 CLI 按需启动」和「启用命令行接口」。")
            time.sleep(0.1)
        return False, LAUNCH_NOT_READY_MESSAGE
    finally:
        if launcher.poll() is None:
            launcher.terminate()
            try:
                launcher.wait(timeout=1)
            except subprocess.TimeoutExpired:
                launcher.kill()


def build_parser():
    # --format 在子命令前后都能写：父解析器用 SUPPRESS 做默认值，没写就不覆盖顶层的值。
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--format", choices=FORMATS, default=argparse.SUPPRESS)

    parser = argparse.ArgumentParser(
        prog="utermctl",
        parents=[shared],
        description=_("通过正在运行的 uTerm 使用其已保存的主机执行命令、读写文件、启停转发"),
    )
    # 别在这里 set_defaults(format=…)：argparse 会把默认值写回**共享的** action 对象，
    # 于是每个子解析器都拿到一个真实默认值，反手把顶层给的 --format 覆盖掉。
    sub = parser.add_subparsers(dest="action", required=True)

    def add(name, help_text, host=False, hosts=False):
        p = sub.add_parser(name, parents=[shared], help=help_text)
        if host:
            p.add_argument("--host", "-H", required=True, help=_("主机名或 UUID"))
        if hosts:
            p.add_argument("--host", "-H", action="append", required=True,
                           help=_("主机名或 UUID，可重复"))
        return p

    add("ping", _("探活并报告版本与两个开关的状态"))
    add("hosts", _("列出已保存的主机"))
    add("host-key", _("查一台主机在信任库里的记录"), host=True)

    p = add("trust", _("按指纹钉住一台主机的密钥"), host=True)
    p.add_argument("--fingerprint", required=True, help=_("必须与当前挑战一致的 SHA256:… 指纹"))

    def with_command(p):
        p.add_argument("--command", "-c", help=_("整串 shell 命令（与 -- 之后的 argv 二选一）"))
        p.add_argument("--timeout", type=int,
                       help=_("静默超时（秒）：连续这么久没有任何输出就终止命令；默认 60，封顶 1800"))
        p.add_argument("--max-duration", type=int,
                       help=_("总时长上限（秒）：不管有没有输出，跑满就终止；默认 3600，封顶 21600"))
        p.add_argument("--max-lines", type=int, help=_("输出行数上限，默认 200"))
        p.add_argument("--max-bytes", type=int, help=_("输出字节上限，默认 16000，封顶 1 MiB"))
        p.add_argument("argv", nargs="*", help=_("-- 之后的命令与参数（原样拼成一条命令）"))
        return p

    with_command(add("run", _("在一台主机上跑一条命令"), host=True))
    with_command(add("run-many", _("在多台主机上并行跑同一条命令"), hosts=True))

    add("quick-commands", _("列出快捷命令"))
    p = sub.add_parser("quick-run", parents=[shared], help=_("跑一条已保存的快捷命令"))
    p.add_argument("name", help=_("快捷命令的名字或 UUID"))
    p.add_argument("--host", "-H", action="append", help=_("覆盖目标主机，可重复"))
    p.add_argument("--timeout", type=int, help=_("静默超时（秒），同 run"))
    p.add_argument("--max-duration", type=int, help=_("总时长上限（秒），同 run"))

    # --- sftp ---
    sftp = sub.add_parser("sftp", parents=[shared], help=_("远程文件操作"))
    sftp_sub = sftp.add_subparsers(dest="sftp_action", required=True)

    def sftp_add(name, help_text):
        p = sftp_sub.add_parser(name, parents=[shared], help=help_text)
        p.add_argument("--host", "-H", required=True, help=_("主机名或 UUID"))
        return p

    p = sftp_add("ls", _("列目录"))
    p.add_argument("path", nargs="?", default=".")

    p = sftp_add("stat", _("看一个文件的类型、大小、权限与修改时间"))
    p.add_argument("path")

    p = sftp_add("cat", _("打印一个文本文件（上限 1 MiB，超限回 file_too_large，改用 get）"))
    p.add_argument("path")
    p.add_argument("--max-bytes", type=int)

    p = sftp_add("get", _("下载一个文件到本地（uTerm 多通道并行，大小不限）"))
    p.add_argument("path")
    p.add_argument("local", help=_("本地落盘路径"))
    transfer_options(p, _("覆盖已存在的本地文件"))

    p = sftp_add("put", _("上传一个本地文件（uTerm 多通道并行，大小不限）"))
    p.add_argument("local", help=_("本地文件路径"))
    p.add_argument("path", help=_("远端目标路径"))
    transfer_options(p, _("覆盖已存在的远端文件"))

    for name, help_text in (
        ("mkdir", _("建目录")),
        ("rm", _("删文件")),
        ("rmdir", _("删空目录")),
    ):
        sftp_add(name, help_text).add_argument("path")

    p = sftp_add("mv", _("改名 / 移动"))
    p.add_argument("path")
    p.add_argument("new_path", metavar="new-path")

    p = sftp_add("chmod", _("改权限"))
    p.add_argument("path")
    p.add_argument("mode", help=_("八进制，如 644"))

    # --- forward ---
    forward = sub.add_parser("forward", parents=[shared], help=_("端口转发规则的增删与启停"))
    forward_sub = forward.add_subparsers(dest="forward_action", required=True)
    p = forward_sub.add_parser("list", parents=[shared], help=_("列出规则与运行状态"))
    p.add_argument("--host", "-H", help=_("只列这台主机的规则"))
    for name, help_text in (
        ("start", _("启动一条规则")),
        ("stop", _("停掉一条规则")),
        ("remove", _("删一条规则（在跑就先停；自启的规则拒绝）")),
    ):
        p = forward_sub.add_parser(name, parents=[shared], help=help_text)
        p.add_argument("--rule", "-r", required=True, help=_("规则名或 UUID"))
        p.add_argument("--host", "-H", help=_("只在这台主机的规则里找（同名规则跨主机时用）"))

    p = forward_sub.add_parser("add", parents=[shared], help=_("在一台主机上新建一条规则（不启动）"))
    p.add_argument("--host", "-H", required=True, help=_("主机名或 UUID"))
    p.add_argument("--name", "-n", required=True, help=_("规则名（同一台主机上不能重名）"))
    p.add_argument("--kind", "-k", required=True, choices=("local", "remote", "dynamic"),
                   help=_("local = -L，remote = -R，dynamic = -D（SOCKS5）"))
    p.add_argument("--listen", "-l", required=True, metavar="[HOST:]PORT",
                   help=_("监听地址。local / dynamic 开在本机，remote 开在服务器上；HOST 缺省 127.0.0.1"))
    p.add_argument("--dest", "-d", metavar="HOST:PORT",
                   help=_("目标地址：local 是服务器能到的地址，remote 是本机能到的地址；dynamic 不给"))

    # --- terminal ---
    add("terminals", _("列出所有窗口里的终端会话"))
    terminal = sub.add_parser("terminal", parents=[shared], help=_("终端会话读屏 / 注入 / 开窗"))
    terminal_sub = terminal.add_subparsers(dest="terminal_action", required=True)

    p = terminal_sub.add_parser("read", parents=[shared], help=_("读一个会话的当前屏幕（快照）"))
    p.add_argument("--terminal", "-t", required=True, help=_("会话 id 或其唯一前缀"))
    p.add_argument("--lines", type=int, help=_("行数，默认 80"))

    p = terminal_sub.add_parser("send", parents=[shared], help=_("往一个会话注入文本"))
    p.add_argument("--terminal", "-t", required=True, help=_("会话 id 或其唯一前缀"))
    p.add_argument("text", help=_("要写入 PTY 的文本"))
    p.add_argument("--enter", action="store_true", help=_("末尾追加回车"))

    p = terminal_sub.add_parser("open", parents=[shared],
                                help=_("给一台主机开一个新终端窗口；给了命令就在窗口里跑它（用户可在窗口里交互）"))
    p.add_argument("--host", "-H", required=True, help=_("主机名或 UUID"))
    p.add_argument("--command", "-c", help=_("连上后在窗口里跑的整串命令（与 -- 之后的 argv 二选一）"))
    p.add_argument("argv", nargs="*", help=_("-- 之后的命令与参数"))

    p = terminal_sub.add_parser("wait", parents=[shared],
                                help=_("等 terminal open -- <命令> 跑的那条命令结束，拿退出码与输出"))
    p.add_argument("--terminal", "-t", required=True, help=_("会话 id 或其唯一前缀"))
    p.add_argument("--wait", type=float, help=_("最多等几秒，默认 90，封顶 1800；没跑完回 state=running"))

    # --- relay ---
    relay = sub.add_parser("relay", parents=[shared], help=_("自建中继：安装命令、导入配置、测试连通"))
    relay_sub = relay.add_subparsers(dest="relay_action", required=True)
    p = relay_sub.add_parser("import", parents=[shared],
                             help=_("让 uTerm 经 SFTP 读主机上安装脚本写的设备配置并存进钥匙串（密钥不经过本客户端）"))
    p.add_argument("--host", "-H", required=True, help=_("装着中继的主机名或 UUID"))
    p.add_argument("--path", help=_("设备配置在远端的路径，默认 ~/.config/uterm-relay/client.json"))
    p.add_argument("--replace", action="store_true", help=_("已经导入了另一台中继时换成这一台"))
    relay_sub.add_parser("check", parents=[shared],
                         help=_("从这台 Mac 测已导入的中继：TCP、成员认证、UDP，附带版本"))
    p = relay_sub.add_parser("install-command", parents=[shared],
                             help=_("打印在服务器上安装 / 更新中继的那一行命令（安装脚本放在哪由这个 uTerm 构建决定）"))
    p.add_argument("--interactive", action="store_true",
                   help=_("给要输 sudo 密码的终端用（curl … | sudo sh）；缺省是 root 直接跑、其他用户 sudo -n 的版本"))
    p.add_argument("argv", nargs="*", help=_("-- 之后是安装脚本的参数，缺省 install；例：-- update"))

    p = add("disconnect", _("松开命令行连接池对主机的持有"))
    p.add_argument("--host", "-H", help=_("不给就释放全部"))

    # --- mac ---
    add("macs", _("列出配对过的 Mac（经远控链路访问它们的文件、跑命令，不需要 SSH）"))
    build_mac_parser(sub, shared)

    return parser


def build_mac_parser(sub, shared):
    mac = sub.add_parser("mac", parents=[shared], help=_("配对过的 Mac：读写文件、搜代码、跑命令"))
    mac_sub = mac.add_subparsers(dest="mac_action", required=True)

    def mac_add(name, help_text):
        p = mac_sub.add_parser(name, parents=[shared], help=help_text)
        p.add_argument("--mac", "-M",
                       help=_("Mac 的名字或 id（见 utermctl macs）。不写 = 此刻正在用这个终端的那台设备"
                              "（只在被别的设备远程控制着的 uTerm 终端里有意义）"))
        return p

    def walk_flags(p):
        p.add_argument("--hidden", action="store_true", help=_("连隐藏文件一起"))
        p.add_argument("--no-ignore", action="store_true", help=_("不按 .gitignore 过滤"))

    p = mac_add("ls", _("列目录"))
    p.add_argument("path", nargs="?", default="~")

    p = mac_add("stat", _("看一个文件的类型、大小、权限与修改时间"))
    p.add_argument("path")

    p = mac_add("cat", _("打印一个文本文件（上限 1 MiB；更大的用 read 读一段或 get 下载）"))
    p.add_argument("path")
    p.add_argument("--max-bytes", type=int)

    p = mac_add("read", _("读文件的一段：按行（--lines / --head / --tail）或按字节（--offset / --length）"))
    p.add_argument("path")
    p.add_argument("--lines", dest="line_range", metavar="A:B", help=_("第 A 行到第 B 行（从 1 起，两端都含；B 可省）"))
    p.add_argument("--head", type=int, metavar="N", help=_("开头 N 行"))
    p.add_argument("--tail", type=int, metavar="N", help=_("最后 N 行"))
    p.add_argument("--offset", type=int, help=_("按字节读：起点"))
    p.add_argument("--length", type=int, help=_("按字节读：长度，封顶 1 MiB"))
    p.add_argument("--max-bytes", type=int, help=_("按行读时内容的字节上限，默认 256 KiB"))

    p = mac_add("grep", _("在目录里搜文件内容（正则；默认跳过 .gitignore 里的和二进制文件）"))
    p.add_argument("pattern")
    p.add_argument("path", nargs="?", default="~")
    p.add_argument("--ignore-case", "-i", action="store_true")
    p.add_argument("--fixed", "-F", action="store_true", help=_("按字面量搜，不当正则"))
    p.add_argument("--include", action="append", metavar="GLOB", help=_("只搜名字匹配的文件，可重复"))
    p.add_argument("--exclude", action="append", metavar="GLOB", help=_("跳过名字匹配的文件，可重复"))
    p.add_argument("--context", "-C", type=int, metavar="N", help=_("每处匹配前后各带 N 行"))
    p.add_argument("--limit", type=int, help=_("最多回多少处，默认 200，封顶 2000"))
    walk_flags(p)

    p = mac_add("find", _("按名字找文件 / 目录"))
    p.add_argument("path", nargs="?", default="~")
    p.add_argument("--name", metavar="GLOB", help=_("名字的通配符，如 '*.swift'"))
    p.add_argument("--type", choices=["f", "d"], help=_("只要文件（f）或只要目录（d）"))
    p.add_argument("--depth", type=int, help=_("最多往下几层"))
    p.add_argument("--newer", type=float, metavar="SECONDS", help=_("只要最近这么多秒内改过的"))
    p.add_argument("--hash", action="store_true", help=_("每个文件带 sha256"))
    p.add_argument("--exclude", action="append", metavar="GLOB")
    p.add_argument("--ignore-case", "-i", action="store_true")
    p.add_argument("--limit", type=int, help=_("最多回多少项，默认 500，封顶 5000"))
    walk_flags(p)

    p = mac_add("tree", _("目录树（文本）"))
    p.add_argument("path", nargs="?", default="~")
    p.add_argument("--depth", type=int, help=_("层数，默认 3"))
    p.add_argument("--limit", type=int, help=_("最多多少项，默认 400"))
    walk_flags(p)

    p = mac_add("hash", _("算一个文件的 sha256"))
    p.add_argument("path")
    p = mac_add("du", _("一个目录占多少空间"))
    p.add_argument("path", nargs="?", default="~")
    p = mac_add("df", _("所在磁盘的可用空间"))
    p.add_argument("path", nargs="?", default="~")

    p = mac_add("get", _("下载一个文件（-r 下载整个目录）"))
    p.add_argument("path")
    p.add_argument("local", help=_("本地落盘路径"))
    p.add_argument("--recursive", "-r", action="store_true", help=_("下载整个目录"))
    transfer_options(p, _("覆盖已存在的本地文件"))

    p = mac_add("put", _("上传一个本地文件（-r 上传整个目录）"))
    p.add_argument("local", help=_("本地文件路径"))
    p.add_argument("path", help=_("那台 Mac 上的目标路径"))
    p.add_argument("--recursive", "-r", action="store_true", help=_("上传整个目录"))
    transfer_options(p, _("覆盖已存在的远端文件"))

    p = mac_add("sync", _("把一个目录同步过去 / 同步回来：只传大小或修改时间不一样的文件"))
    p.add_argument("direction", choices=["up", "down"], help=_("up：本地 → 那台 Mac；down：反过来"))
    p.add_argument("local", help=_("本地目录"))
    p.add_argument("path", help=_("那台 Mac 上的目录"))
    p.add_argument("--delete", action="store_true", help=_("目标里多出来的文件删掉（up 时移进那台 Mac 的废纸篓）"))
    p.add_argument("--checksum", action="store_true", help=_("大小相同、时间不同的文件先比 sha256，一样就不传"))
    p.add_argument("--dry-run", action="store_true", help=_("只列要做什么，不动文件"))
    p.add_argument("--exclude", action="append", metavar="GLOB", help=_("跳过名字匹配的文件或目录，可重复"))
    p.add_argument("--parallel", type=int, default=DEFAULT_PARALLEL)
    p.add_argument("--quiet", action="store_true")

    p = mac_add("mkdir", _("建目录"))
    p.add_argument("path")
    p.add_argument("--parents", "-p", action="store_true", help=_("连上级目录一起建；已存在不算错"))

    p = mac_add("rm", _("删文件（-r 删整个目录；想留后路用 trash）"))
    p.add_argument("path")
    p.add_argument("--recursive", "-r", action="store_true")

    mac_add("rmdir", _("删空目录")).add_argument("path")
    mac_add("trash", _("移到废纸篓（能从废纸篓放回）")).add_argument("path")

    for name, help_text in (("mv", _("改名 / 移动")), ("cp", _("复制（目录整个复制）"))):
        p = mac_add(name, help_text)
        p.add_argument("path")
        p.add_argument("new_path", metavar="new-path")
        p.add_argument("--force", action="store_true", help=_("目标已存在时覆盖"))

    p = mac_add("chmod", _("改权限"))
    p.add_argument("path")
    p.add_argument("mode", help=_("八进制，如 644"))
    p.add_argument("--recursive", "-R", action="store_true")

    p = mac_add("ln", _("建符号链接"))
    p.add_argument("target", help=_("链接指向哪里"))
    p.add_argument("path", help=_("链接放在哪里"))
    p.add_argument("--force", action="store_true", help=_("已存在时替换"))
    mac_add("readlink", _("看符号链接指向哪里")).add_argument("path")

    p = mac_add("touch", _("建空文件 / 更新修改时间"))
    p.add_argument("path")

    p = mac_add("write", _("写一个文本文件（内容来自 --text、--file 或标准输入）；默认只肯新建"))
    p.add_argument("path")
    p.add_argument("--text", help=_("要写的内容"))
    p.add_argument("--file", dest="source", help=_("从这个本地文件读内容"))
    p.add_argument("--force", action="store_true", help=_("覆盖已存在的文件"))
    p.add_argument("--if-match", metavar="SHA256", help=_("只有文件现在的 sha256 是这个才写（防止盖掉别人的改动）"))
    p.add_argument("--mode", help=_("新文件的权限，八进制"))

    p = mac_add("edit", _("把文件里的一段文字换成另一段（要换的文字必须只出现一次，除非 --all）"))
    p.add_argument("path")
    p.add_argument("--old", required=True, help=_("原文，一字不差"))
    p.add_argument("--new", required=True, help=_("换成什么"))
    p.add_argument("--all", action="store_true", help=_("出现几次换几次"))
    p.add_argument("--if-match", metavar="SHA256")

    p = mac_add("patch", _("打一个 unified diff（来自 --file 或标准输入）"))
    p.add_argument("path", nargs="?", default="~", help=_("在哪个目录下打，默认主目录"))
    p.add_argument("--file", dest="source", help=_("本地的 diff 文件"))
    p.add_argument("--strip", "-p", type=int, help=_("去掉路径前几段，同 patch -p，默认 1"))
    p.add_argument("--dry-run", action="store_true", help=_("只检查能不能打上"))

    p = mac_add("xattr", _("扩展属性：list / get / set / remove"))
    p.add_argument("path")
    p.add_argument("attribute_action", nargs="?", default="list", choices=["list", "get", "set", "remove"])
    p.add_argument("attribute", nargs="?")
    p.add_argument("value", nargs="?")

    mac_add("shares", _("那台设备给这台 Mac 开放了哪些目录（整台 Mac，还是几个共享文件夹）"))

    p = mac_add("wait-change", _("等一个文件或目录有变化"))
    p.add_argument("path")
    p.add_argument("--wait", type=float, help=_("最多等几秒，默认 30，封顶 600"))

    p = mac_add("run", _("在那台 Mac 上跑一条命令（登录 shell，没有 stdin）"))
    p.add_argument("--cwd", help=_("在哪个目录下跑，默认主目录"))
    p.add_argument("--command", "-c", help=_("整串 shell 命令（与 -- 之后的 argv 二选一）"))
    p.add_argument("--timeout", type=int, help=_("静默超时（秒），默认 60，封顶 1800"))
    p.add_argument("--max-duration", type=int, help=_("总时长上限（秒），默认 3600，封顶 21600"))
    p.add_argument("--max-lines", type=int, help=_("输出行数上限，默认 200"))
    p.add_argument("--max-bytes", type=int, help=_("输出字节上限，默认 16000，封顶 1 MiB"))
    p.add_argument("argv", nargs="*", help=_("-- 之后的命令与参数"))


def transfer_options(p, force_help):
    """`sftp get` / `sftp put` 共用的传输选项。

    `--force`（整份重来、覆盖目标）与 `--resume`（补没传完的区间）是互相矛盾的两件事，
    放进同一个互斥组：一起给就是 argparse 报错、退出码 2。
    """
    exclusive = p.add_mutually_exclusive_group()
    exclusive.add_argument("--force", action="store_true", help=force_help)
    exclusive.add_argument("--resume", action="store_true",
                           help=_("断点续传：按续传状态文件补没传完的区间（与 --force 互斥）"))
    p.add_argument("--parallel", type=int, default=DEFAULT_PARALLEL,
                   help=_("uTerm 用几条 SFTP 通道并行传，1–{max}，默认 {default}").format(
                       max=MAX_PARALLEL, default=DEFAULT_PARALLEL))
    p.add_argument("--no-verify", dest="verify", action="store_false", default=True,
                   help=_("传完不比对 sha256（默认对 8 MiB 以上的文件校验）"))
    p.add_argument("--quiet", action="store_true",
                   help=_("不刷进度行（结束仍打一行汇总到 stderr）"))
    return p


def parse_endpoint(text, flag, need_host):
    """`PORT` / `HOST:PORT` / `[IPv6]:PORT` → (host 或 None, port)。"""
    text = (text or "").strip()
    host = None
    port_text = text
    if text.startswith("["):
        close = text.find("]")
        if close < 0 or text[close + 1:close + 2] != ":":
            fail(_("{flag} 写成 [IPv6]:PORT：{text}").format(flag=flag, text=text))
        host, port_text = text[1:close], text[close + 2:]
    elif ":" in text:
        if text.count(":") > 1:
            fail(_("{flag} 里的 IPv6 地址要加方括号，如 [::1]:8080：{text}").format(flag=flag, text=text))
        host, port_text = text.rsplit(":", 1)
    if not port_text.isdigit() or not 1 <= int(port_text) <= 65535:
        fail(_("{flag} 的端口需在 1–65535 之间：{text}").format(flag=flag, text=text))
    if need_host and not host:
        fail(_("{flag} 要写成 HOST:PORT：{text}").format(flag=flag, text=text))
    return host or None, int(port_text)


def forward_spec(args):
    listen_host, listen_port = parse_endpoint(args.listen, "--listen", need_host=False)
    spec = {"kind": args.kind, "listenPort": listen_port}
    if listen_host:
        spec["listenHost"] = listen_host
    if args.kind == "dynamic":
        if args.dest:
            fail(_("dynamic（SOCKS5）规则没有固定目标，不要给 --dest"))
        return spec
    if not args.dest:
        fail(_("{kind} 规则需要 --dest HOST:PORT").format(kind=args.kind))
    dest_host, dest_port = parse_endpoint(args.dest, "--dest", need_host=True)
    spec["destHost"] = dest_host
    spec["destPort"] = dest_port
    return spec


def resolved_action(args):
    """把 `sftp ls` / `forward list` / `terminal read` 拼成协议里的 kebab action。"""
    for group in ("sftp", "forward", "terminal", "relay", "mac"):
        leaf = getattr(args, group + "_action", None)
        if args.action == group and leaf:
            return "%s-%s" % (group, leaf)
    return args.action


def command_string(args, optional=False):
    inline = getattr(args, "command", None)
    argv = list(getattr(args, "argv", []))
    # `--` 是命令的一部分，**不能过滤**：`run -H h -- grep -- --include f` 里那个
    # `--` 是 grep 的参数分隔符，滤掉就变成了另一条命令。
    # 实测 argparse（本机 3.9.6 / 3.10.21 / 3.13.15 / 3.14.7，含子解析器）只吃掉
    # 分隔用的**第一个** `--`，不会留在 argv 里；下面这行只是防御：万一某个版本把它
    # 留下，也只去掉开头那一个。
    if argv[:1] == ["--"]:
        argv = argv[1:]
    if inline and argv:
        fail(_("-c 与 -- 之后的命令只能给一个"))
    if inline:
        return inline
    if argv:
        return shlex.join(argv)
    if optional:
        return None
    fail(_("缺少命令：用 -c \"…\" 或在 -- 之后写命令"))


def make_request(args):
    action = resolved_action(args)
    request = {"id": str(uuid.uuid4()), "action": action}

    # `macs` 也带上「我在哪个终端里」：列表里才标得出此刻正在用这个终端的那台设备。
    if action == "macs" and os.environ.get(ENV_SESSION):
        request["mac"] = {"session": os.environ[ENV_SESSION]}

    host = getattr(args, "host", None)
    if isinstance(host, list):
        request["hosts"] = host
    elif host:
        request["host"] = host

    if action in ("run", "run-many"):
        request["command"] = command_string(args)
    if action == "terminal-open":
        command = command_string(args, optional=True)
        if command is not None:
            request["command"] = command
    if action == "forward-add":
        request["name"] = args.name
        request["forward"] = forward_spec(args)
    if action == "quick-run":
        # 协议里 `name` 是按名字指定的显式入口，`command` 也接受「快捷命令的名字 / id」。
        # 两个都填，服务端读哪个都对。
        request["name"] = args.name
        request["command"] = args.name

    for field, key in (
        ("timeout", "timeoutSeconds"),
        ("max_duration", "maxDurationSeconds"),
        ("max_lines", "maxLines"),
        ("max_bytes", "maxBytes"),
        ("lines", "lines"),
        ("path", "path"),
        ("new_path", "newPath"),
        ("mode", "mode"),
        ("rule", "rule"),
        ("terminal", "terminal"),
        ("text", "text"),
        ("fingerprint", "fingerprint"),
        ("wait", "waitSeconds"),
    ):
        value = getattr(args, field, None)
        if value is not None and value != "":
            request[key] = value

    if getattr(args, "enter", False):
        request["enter"] = True
    if action == "relay-import" and getattr(args, "replace", False):
        request["force"] = True
    if action == "relay-install-command":
        argv = list(getattr(args, "argv", []) or [])
        if argv[:1] == ["--"]:
            argv = argv[1:]
        if argv:
            request["args"] = argv
        if getattr(args, "interactive", False):
            request["mode"] = "interactive"

    return request


def fail(message):
    sys.stderr.write(message + "\n")
    sys.exit(EXIT_LOCAL)


def send_request(request, fd=None, on_progress=None):
    """发一条请求。`fd` 给了就随请求经 `SCM_RIGHTS` 交给 uTerm（`sftp-get` / `sftp-put`
    的本地文件）；`on_progress` 收传输期间的进度行。"""
    paths = socket_paths()
    stale = []
    found_socket = False
    for path in paths:
        if not os.path.exists(path):
            continue
        found_socket = True
        try:
            return exchange(path, request, fd, on_progress)
        except ConnectionRefusedError:
            # 文件在、没人监听 = 上一个实例被强杀（Xcode 重新 Run、崩溃）留下的残留，
            # 它自己没机会 unlink。和「uTerm 没装/没开」是两回事，别混成一个错。
            stale.append(path)
        except OSError as error:
            return {
                "id": request.get("id"),
                "ok": False,
                "code": "socket_error",
                "message": "%s: %s" % (path, error),
            }
    # Only launch before the business request has been delivered. Once exchange() accepted
    # bytes, an unknown result is returned as-is and is never replayed automatically.
    launch_error = None
    if not found_socket or stale:
        started, launch_error = start_background_and_wait()
        if started:
            for path in paths:
                if os.path.exists(path):
                    try:
                        return exchange(path, request, fd, on_progress)
                    except (ConnectionRefusedError, OSError):
                        continue
        elif launch_error and not found_socket:
            return (socket_path_too_long_response(request, paths, launch_error)
                    or {"id": request.get("id"), "ok": False,
                        "code": CODE_NOT_RUNNING, "message": launch_error})
    if stale:
        return {
            "id": request.get("id"),
            "ok": False,
            "code": CODE_SOCKET_STALE,
            "message": (_("socket 文件还在但没有进程在监听（{paths}）。"
                          "uTerm 多半正在重启或刚被强制退出 —— 等它起来后重试一次；"
                          "若 uTerm 确实没在运行，这个文件会在下次启动时自动清掉。"
                          ).format(paths=_("、").join(stale))
                        # 残留 socket 时也试过按需启动：没起来的原因别吞掉，否则调用方只会干等。
                        + (_(" 按需启动没成功：{error}").format(error=launch_error)
                           if launch_error else "")),
        }
    too_long = socket_path_too_long_response(request, paths, launch_error)
    if too_long:
        return too_long
    return {
        "id": request.get("id"),
        "ok": False,
        "code": CODE_NOT_RUNNING,
        "message": _("uTerm 的 IPC socket 不存在（试过 {paths}）。"
                     "确认 uTerm 正在运行，且设置 ▸ 命令行与技能 里已打开「启用命令行接口」。"
                     ).format(paths=_("、").join(paths)),
    }


class ServerSilent(Exception):
    """uTerm 连续 `CLIENT_IDLE_TIMEOUT` 秒一个字节都没发（连心跳都没有）。"""


def read_response(sock, on_progress=None):
    """读到 EOF，一行一行处理：空行是心跳，`{"event":"progress"}` 交给 `on_progress`，
    其余那一行是最终响应。读不到响应返回 None。

    socket 超时是**每次 recv** 的，心跳 / 进度一到就重新计时。
    """
    buffered = b""
    final = [None]
    leftovers = []      # 不是单行 JSON 的行（兜底：多行格式的响应）

    def consume(line):
        line = line.strip()
        if not line:
            return
        try:
            body = json.loads(line.decode("utf-8"))
        except ValueError:
            leftovers.append(line)
            return
        if isinstance(body, dict) and body.get("event") == "progress":
            if on_progress is not None:
                on_progress(body)
        elif isinstance(body, dict):
            final[0] = body

    try:
        while True:
            chunk = sock.recv(65536)
            if not chunk:
                break
            buffered += chunk
            while b"\n" in buffered:
                line, buffered = buffered.split(b"\n", 1)
                consume(line)
    except socket.timeout:
        raise ServerSilent()
    except OSError:
        # 对端已经把连接拆了；已经收到的那部分仍然可能是完整的一条响应。
        pass
    consume(buffered)
    if final[0] is None and leftovers:
        # 服务端一行一个 JSON；万一碰上把响应排成多行的实现，把剩下的行拼回去再解一次。
        try:
            body = json.loads(b"\n".join(leftovers).decode("utf-8"))
            if isinstance(body, dict):
                final[0] = body
        except ValueError:
            pass
    return final[0]


def exchange(path, request, fd=None, on_progress=None):
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(CLIENT_IDLE_TIMEOUT)
    try:
        return _exchange(sock, path, request, fd, on_progress)
    except ServerSilent:
        return {
            "id": request.get("id"),
            "ok": False,
            "code": "client_timeout",
            "message": _("uTerm 连续 {seconds} 秒没有任何回应（处理中每 10 秒一次的心跳也没有），"
                         "多半是 uTerm 本身卡住了；请求可能已经执行了一部分。"
                         ).format(seconds="%d" % CLIENT_IDLE_TIMEOUT),
        }
    finally:
        sock.close()


def _exchange(sock, path, request, fd=None, on_progress=None):
    try:
        sock.connect(path)
        payload = json.dumps(request).encode("utf-8")
        try:
            if fd is None:
                sock.sendall(payload)
            else:
                # fd 挂在第一段数据上（SCM_RIGHTS）；没发完的部分照常补。
                sent = sock.sendmsg(
                    [payload], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", [fd]))])
                if sent < len(payload):
                    sock.sendall(payload[sent:])
            sock.shutdown(socket.SHUT_WR)
        except (BrokenPipeError, ConnectionResetError):
            # 服务端可能**在我们写完之前**就回了一条响应并关掉连接（请求体超限之类）。
            # AF_UNIX 上已经写回的数据不会因对端 close 而丢，所以先把它读出来：
            # 读到 JSON 就按正常响应处理，读不到才把 EPIPE 报成 socket_error。
            response = read_response(sock, on_progress)
            if response is not None:
                return response
            raise
        response = read_response(sock, on_progress)
    except socket.timeout:
        # connect / send 阶段的超时同样是「uTerm 不回应」。
        raise ServerSilent()
    if response is None:
        return {
            "id": request.get("id"),
            "ok": False,
            "code": "empty_response",
            "message": _("uTerm IPC 返回了空响应或读不懂的内容"),
        }
    return response


def exit_code_for(response):
    if response.get("ok"):
        return EXIT_OK
    code = response.get("code") or ""
    # `server_busy` 与 `empty_response` 是同一件事的两种表现（服务端槽位满，后者是它
    # 直接关连接）；`local_*` 是客户端自己的磁盘 / 本地文件问题 —— 都归「本地」这一档。
    if code in (CODE_NOT_RUNNING, CODE_SOCKET_STALE, CODE_SOCKET_PATH_TOO_LONG,
                "socket_error", "empty_response",
                "server_busy", "local_read_failed", "local_write_failed",
                "local_failure"):
        return EXIT_LOCAL
    if code in ("control_disabled", "mutations_disabled", "host_sftp_only", "rule_protected"):
        return EXIT_GATED
    if code.endswith("_not_found") or code.endswith("_ambiguous"):
        return EXIT_NOT_FOUND
    if (code in ("connect_failed", "auth_failed", "forward_failed", "relay_unreachable")
            or code.startswith("host_key_") or code.endswith("_refused")):
        return EXIT_REMOTE
    if code in ("command_timeout", "handler_timeout", "client_timeout"):
        return EXIT_TIMEOUT
    # run-many / quick-run：全失败按「远端失败」报，有成有败单独给一档，
    # 好让脚本能区分「一台都没成」和「大部分成了」。
    if code == "run_failed":
        return EXIT_REMOTE
    if code == "run_partial_failure":
        return EXIT_PARTIAL
    return EXIT_OTHER


# ---------------------------------------------------------------------------
# 大文件传输：本地文件交给 uTerm，由它并行搬
#
# 客户端只做本地那一半：`get` 建好 `<目标>.part`、`put` 打开本地文件，然后把 fd 随请求
# 经 `SCM_RIGHTS` 交给 uTerm（沙盒 app 打不开任意本地路径）。沙盒进程往 fd 里写过的文件
# 会被系统打上 quarantine，下载成功后由这里去掉（`strip_quarantine`）。uTerm 在里面开 `--parallel` 条 SFTP 通道并行读写这个 fd，文件字节不走
# socket；同一条连接上每 0.5 秒回一行进度 `{"event":"progress","bytes",…,"done":[…]}`，
# 最后一行是结果。
#
# 断点续传：进度行里的 `done` 是新完成的段，客户端把它们并进 sidecar
# （`<本地路径>.utermctl-transfer.json`）。`--resume` 只请求缺的区间（`ranges`）；传到一半
# 撞上可重试的错误（连接断了、服务端忙）也是这样自动续上的，不从头来。
# ---------------------------------------------------------------------------

# 这些码重试没有意义：门禁、找不到、参数不对、远端已存在、密钥没信任，以及本地磁盘 /
# 本地文件问题（重试改变不了事实）。
PERMANENT_CODES = frozenset([
    "control_disabled", "mutations_disabled", "host_sftp_only",
    "invalid_request", "not_implemented", "file_exists", "file_too_large",
    "permission_denied", "is_directory", "auth_failed", "request_too_large",
    "local_read_failed", "local_write_failed", "local_failure",
    CODE_NOT_RUNNING, CODE_SOCKET_STALE,
])


def new_request(action, **fields):
    """带 id 的请求体；值为 None 的字段不出现在 JSON 里。"""
    body = {"id": str(uuid.uuid4()), "action": action}
    for key, value in fields.items():
        if value is not None:
            body[key] = value
    return body


def is_retryable(code):
    if code in PERMANENT_CODES:
        return False
    if code.endswith("_not_found") or code.endswith("_ambiguous"):
        return False
    return not code.startswith("host_key_")


def backoff(seconds):
    """退避。`UTERMCTL_SLEEP_TRACE`（自测专用）指向一个文件时只记账、不真的睡。"""
    if SLEEP_TRACE:
        try:
            with open(SLEEP_TRACE, "a") as handle:
                handle.write("%.3f\n" % seconds)
        except OSError:
            pass
        return
    time.sleep(seconds)


def send_with_retry(attempt):
    """把「一次尝试」按错误码退避重试。

    `attempt(previous)` 返回一条响应，`previous` 是上一次的失败响应（第一次是 None）。
    槽位满（`server_busy` / 服务端直接关连接时看到的 `empty_response`）更耐心：
    退避 0.5/1/2 s 后每 4 s 一次，约 1 分钟；其余可重试码 2 次（0.5 / 1 s）。
    """
    response = attempt(None)
    tries = 0
    while not response.get("ok"):
        code = response.get("code") or ""
        if not is_retryable(code):
            break
        delays = BUSY_RETRY_DELAYS if code in BUSY_CODES else RETRY_DELAYS
        if tries >= len(delays):
            break
        backoff(delays[tries])
        tries += 1
        response = attempt(response)
    return response


def parallel_for(args):
    value = getattr(args, "parallel", DEFAULT_PARALLEL)
    if value < 1 or value > MAX_PARALLEL:
        fail(_("--parallel 要在 1–{max} 之间，实得 {value}").format(max=MAX_PARALLEL, value="%d" % value))
    return value


def human(count):
    value = float(count)
    for unit in ("B", "KiB", "MiB"):
        if value < 1024:
            return "%d %s" % (count, unit) if unit == "B" else "%.1f %s" % (value, unit)
        value /= 1024.0
    return "%.2f GiB" % value


def clock(seconds):
    seconds = int(max(seconds, 0))
    return "%d:%02d" % (seconds // 60, seconds % 60)


class Progress(object):
    """stderr 上的一行进度。tty 上原地刷新；非 tty 或 `--quiet` 时不刷，只在结束
    打一行汇总（stdout 留给 JSON，进度绝不能污染它）。"""

    def __init__(self, label, total, live, silent=False):
        self.label = label
        self.total = total
        self.live = live and not silent
        self.silent = silent
        self.done = 0
        self.started = time.time()
        self.drawn = False
        self.last = 0.0

    def update(self, done):
        self.done = done
        now = time.time()
        if not self.live or now - self.last < 0.2:
            return
        self.last = now
        self.drawn = True
        sys.stderr.write("\r\033[K" + self._line(now))
        sys.stderr.flush()

    def _line(self, now):
        seconds = max(now - self.started, 0.001)
        speed = self.done / 1048576.0 / seconds
        remaining = (self.total - self.done) / 1048576.0 / speed if speed > 0 else 0
        return "%s %s / %s  %.1f MiB/s  ETA %s" % (
            self.label, human(self.done), human(self.total), speed, clock(remaining))

    def finish(self, note):
        if self.drawn:
            sys.stderr.write("\r\033[K")
            self.drawn = False
        if note and not self.silent:
            sys.stderr.write(note + "\n")
        sys.stderr.flush()


def merge_ranges(ranges):
    """[(offset, length)] → 按起点排序、相邻/重叠合并后的列表。"""
    merged = []
    for offset, length in sorted((int(o), int(n)) for o, n in ranges if int(n) > 0):
        if merged and offset <= merged[-1][0] + merged[-1][1]:
            end = max(merged[-1][0] + merged[-1][1], offset + length)
            merged[-1] = (merged[-1][0], end - merged[-1][0])
        else:
            merged.append((offset, length))
    return merged


def missing_ranges(done, total):
    """[0, total) 里还没完成的区间。"""
    gaps = []
    cursor = 0
    for offset, length in merge_ranges(done):
        if offset > cursor:
            gaps.append((cursor, offset - cursor))
        cursor = max(cursor, offset + length)
    if cursor < total:
        gaps.append((cursor, total - cursor))
    return gaps


class TransferState(object):
    """续传状态 sidecar：`<本地路径>.utermctl-transfer.json`（put / get 都写在本地）。

    为什么要它：并行传输失败留下的是**带空洞的文件**（get 那边还是满尺寸的 NUL 洞），
    按大小续传会永远跳过空洞、拼出一个悄悄错掉的文件。所以哪些区间成了必须显式记账：
    进度行一到就并进来、节流落盘（写 `.tmp` 再 rename），整趟成功后删掉。

    落盘的字段：version / direction（put|get）/ remotePath / localPath / totalBytes /
    identity（远端或本地文件的身份，续传前核对）/ done（已完成区间 [[offset, length], …]）
    """

    def __init__(self, path, direction, remote, local, total, identity, done=None):
        self.path = path
        self.direction = direction
        self.remote = remote
        self.local = local
        self.total = int(total)
        self.identity = identity
        self.done = merge_ranges(done or [])
        self.disabled = False
        self.armed = False
        self.note = None
        self.saved_at = 0.0

    @staticmethod
    def load(path):
        """读一份 sidecar；不存在 / 读不懂 / 版本对不上都当没有。"""
        try:
            with open(path, "r") as handle:
                body = json.load(handle)
        except (OSError, ValueError):
            return None
        if not isinstance(body, dict) or body.get("version") != SIDECAR_VERSION:
            return None
        return body

    @property
    def completed(self):
        return sum(length for _, length in self.done)

    def missing(self):
        return missing_ranges(self.done, self.total)

    def add(self, ranges):
        self.done = merge_ranges(self.done + [(r.get("offset", 0), r.get("length", 0))
                                             for r in ranges])
        now = time.time()
        if now - self.saved_at >= 0.5:
            self.save()

    def save(self):
        if self.disabled:
            return
        self.saved_at = time.time()
        body = {
            "version": SIDECAR_VERSION,
            "direction": self.direction,
            "remotePath": self.remote,
            "localPath": self.local,
            "totalBytes": self.total,
            "identity": self.identity,
            "done": [[offset, length] for offset, length in self.done],
            "updatedAt": round(self.saved_at, 3),
        }
        tmp = self.path + ".tmp"
        try:
            with open(tmp, "w") as handle:
                json.dump(body, handle)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(tmp, self.path)      # 原子：读的人要么看到旧的、要么看到新的
            self.armed = True
        except OSError as error:
            # 写不了状态文件（目录只读之类）不该让传输失败，但要说清「这趟不能续传」。
            self.disabled = True
            self.note = _("续传状态文件写不了（{error}）—— 这趟传完之前断了就没法 --resume").format(error=error)
            try:
                os.unlink(tmp)
            except OSError:
                pass

    def remove(self):
        for path in (self.path + ".tmp", self.path):
            try:
                os.unlink(path)
            except OSError:
                pass

    def hint(self, target):
        """失败时给用户的续传提示。"""
        if self.disabled:
            return _("没有续传状态（{note}）—— 删掉 {target} 整份重传").format(note=self.note, target=target)
        if not self.armed:
            return _("还没有任何区间完成 —— 整份重传（目标已存在时加 --force）")
        return _("续传状态在 {path}，加 --resume 接着传（别去动 {target}）").format(path=self.path, target=target)


def sidecar_path(local):
    return local + SIDECAR_SUFFIX


def local_identity(path):
    """put 的身份：本地源文件的大小 + mtime（纳秒）。"""
    info = os.stat(path)
    return {"size": info.st_size, "mtimeNs": info.st_mtime_ns}


def remote_identity(stat):
    """get 的身份：远端的大小 + mtime。"""
    return {"size": int((stat or {}).get("size") or 0),
            "modifiedAt": (stat or {}).get("modifiedAt")}


def identity_matches(saved, current):
    """大小必须一样；两边都有的时间戳也必须一样（少了一边就只认大小）。"""
    try:
        if int(saved.get("size", -1)) != int(current.get("size", -2)):
            return False
    except (TypeError, ValueError):
        return False
    for key in ("mtimeNs", "modifiedAt"):
        left, right = saved.get(key), current.get(key)
        if left is not None and right is not None and left != right:
            return False
    return True


def state_for(direction, args, local, total, identity):
    """按 `--resume` 与 sidecar 决定这趟从哪起。前置拒绝一律 `fail()`（退出码 2）。"""
    path = sidecar_path(local)
    if not args.resume:
        return TransferState(path, direction, args.path, local, total, identity)
    saved = TransferState.load(path)
    if saved is None:
        fail(_("没有续传状态文件 {path} —— 上一趟没留下可续的记录，去掉 --resume 整份重传").format(path=path))
    if saved.get("direction") != direction or saved.get("remotePath") != args.path:
        fail(_("续传状态文件 {path} 记的是 {saved_direction} {saved_remote}，与这次的 {direction} {remote} 不是一回事 —— "
               "删掉它，或换一个本地路径").format(
                   path=path, saved_direction=saved.get("direction"), saved_remote=saved.get("remotePath"),
                   direction=direction, remote=args.path))
    if not identity_matches(saved.get("identity") or {}, identity):
        fail(_("续传状态文件 {path} 记的文件已经变了（记的 {saved!r}，现在 {current!r}）—— 接着传会拼出一个"
               "错的文件。删掉它再整份重传").format(path=path, saved=saved.get("identity"), current=identity))
    return TransferState(path, direction, args.path, local, total, identity,
                         done=saved.get("done") or [])


def strip_quarantine(path):
    """去掉 uTerm 写入时系统打上的 `com.apple.quarantine`。

    文件虽然是这里建的，但沙盒进程经 fd 往里写，系统照样给它打上隔离标记（实测
    `0086;…;uTerm;`）—— 下载下来的脚本 / 可执行文件会因此被 Gatekeeper 拦。这个进程
    不在沙盒里，删得掉。没有这个属性（ENOATTR）或平台不支持都不是错。
    """
    try:
        import ctypes
        import ctypes.util
        libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
        libc.removexattr(os.fsencode(path), b"com.apple.quarantine", 0)
    except (OSError, AttributeError):
        pass


def local_sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def is_mac(args):
    """这条命令的对象是不是一台 Mac（`mac …`）。`--mac` 可以不写，所以不能拿它有没有值来判断。"""
    return getattr(args, "mac_action", None) is not None or getattr(args, "is_mac", False)


def mac_target(args):
    """`mac` 字段里指明对象的那部分：点名的 Mac，加上「我在哪个终端里」。

    uTerm 开本机终端时把终端的编号写进 `UTERM_SESSION_ID`。带上它，uTerm 才能在没写 `--mac` 时现查
    「此刻是哪台设备在用这个终端」——设备会换（手机接管之后 Mac 又接管），所以环境变量里只有终端的编号，
    没有设备名。"""
    target = {}
    name = getattr(args, "mac", None)
    if name:
        target["target"] = name
    session = os.environ.get(ENV_SESSION)
    if session:
        target["session"] = session
    return target


def target_fields(args):
    """这次传输 / 查询的对象：一台 Mac（`mac …`）或 SSH 主机（`sftp …`）。"""
    if is_mac(args):
        return {"mac": mac_target(args)}
    return {"host": args.host}


def transfer_action(args, verb):
    return ("mac-" if is_mac(args) else "sftp-") + verb


def remote_sha256(args, path):
    """回 (十六进制, None) 或 (None, 说明)。远端两个工具都没有不算失败。"""
    if is_mac(args):
        response = send_request(new_request("mac-hash", path=path, **target_fields(args)))
        if not response.get("ok"):
            return None, _("那台 Mac 算 sha256 没成（{code}：{message}），跳过校验").format(
                code=response.get("code"), message=response.get("message") or "")
        return ((response.get("mac") or {}).get("sha256") or "").lower() or None, None
    host = args.host
    quoted = shlex.quote(path)
    command = ("sha256sum -- %s 2>/dev/null || shasum -a 256 -- %s"
               % (quoted, quoted))
    response = send_request(new_request(
        "run", host=host, command=command,
        timeoutSeconds=REMOTE_SHA256_TIMEOUT, maxLines=5))
    if not response.get("ok"):
        return None, _("远端算 sha256 没跑成（{code}：{message}），跳过校验").format(
            code=response.get("code"), message=response.get("message") or "")
    match = SHA256_RE.search((response.get("result") or {}).get("output") or "")
    if match is None:
        return None, _("远端既没有 sha256sum 也没有 shasum，跳过校验")
    return match.group(1).lower(), None


def verify_pair(args, local_path, total):
    """校验缺省开，但只对不小于 `VERIFY_MIN_BYTES` 的文件做：`run` 归「允许执行命令与
    写入」开关管，小文件的只读下载不该被它拖下水；大文件才值得多花一次远端哈希。"""
    verdict = {"sha256": None, "verified": False, "note": None, "remote": None}
    if not getattr(args, "verify", True):
        verdict["note"] = _("已用 --no-verify 关掉校验")
        return verdict
    if total < VERIFY_MIN_BYTES:
        verdict["note"] = _("小于 {size}，默认不做 sha256 校验").format(size=human(VERIFY_MIN_BYTES))
        return verdict
    verdict["sha256"] = local_sha256(local_path)
    remote, note = remote_sha256(args, args.path)
    verdict["remote"] = remote
    if remote is None:
        verdict["note"] = note
        return verdict
    verdict["verified"] = remote == verdict["sha256"]
    if not verdict["verified"]:
        verdict["note"] = _("sha256 不一致：本地 {local}，远端 {remote}").format(
            local=verdict["sha256"], remote=remote)
    return verdict


def remote_stat(args, path):
    """回 (stat 字典, None) 或 (None, 失败响应)。"""
    response = send_request(new_request(transfer_action(args, "stat"), path=path,
                                        **target_fields(args)))
    if not response.get("ok"):
        return None, response
    return (response.get("stat") or {}), None


def transfer_stats(kind, args, **fields):
    seconds = round(max(time.time() - fields["started"], 0.0), 3)
    moved = fields["bytes"]
    speed = round(moved / 1048576.0 / seconds, 2) if seconds > 0 and moved else 0.0
    return {
        "action": kind,
        "localPath": os.path.abspath(os.path.expanduser(args.local)),
        "remotePath": args.path,
        "bytes": moved,
        "totalBytes": fields["total"],
        "parallel": fields["parallel"],
        "seconds": seconds,
        "mbps": speed,                       # MiB/s
        "resumedFrom": fields["resumed"],
        "sha256": fields.get("sha256"),
        "verified": fields.get("verified", False),
        "verifyNote": fields.get("verifyNote"),
        # 失败后的恢复账：目标是不是半截的、还能不能 --resume、状态文件与半成品在哪。
        "incomplete": fields.get("incomplete", False),
        "resumable": fields.get("resumable", False),
        "statePath": fields.get("statePath"),
        "partPath": fields.get("partPath"),
    }


def transfer_failure(response, stats):
    """传输失败：保留服务端的 code / message（退出码沿用既有映射），附上已传的账。"""
    return {
        "id": response.get("id"),
        "ok": False,
        "code": response.get("code") or "operation_failed",
        "message": response.get("message") or _("传输失败"),
        "hostKey": response.get("hostKey"),
        "transfer": stats,
    }


def run_transfer(action, args, fd, state, workers, progress, base_fields):
    """发传输请求（带 fd），收进度、记账；可重试的失败按缺的区间自动续上。

    第一次按 `base_fields` 原样发（`put` 的覆盖语义就在这一次定）；之后的每次重试只要
    记账里有任何完成的区间，就改成只补 `ranges`，服务端不再动已有内容。
    """
    started_with = state.completed

    def on_progress(event):
        state.add(event.get("done") or [])
        progress.update(state.completed - started_with)

    def attempt(previous):
        fields = dict(base_fields)
        if previous is not None and state.done:
            fields["ranges"] = [{"offset": o, "length": n} for o, n in state.missing()]
            fields.pop("force", None)
        elif args.resume:
            fields["ranges"] = [{"offset": o, "length": n} for o, n in state.missing()]
        fields.update(target_fields(args))
        return send_request(new_request(action, path=args.path,
                                        parallel=workers, **fields),
                            fd=fd, on_progress=on_progress)

    response = send_with_retry(attempt)
    state.save()
    return response


def do_put(args):
    local = os.path.expanduser(args.local)
    if not os.path.isfile(local):
        fail(_("本地文件不存在：{path}").format(path=local))
    total = os.path.getsize(local)
    workers = parallel_for(args)
    started = time.time()
    state = state_for("put", args, local, total, local_identity(local))
    resumed = state.completed
    if args.resume and not state.missing():
        fail(_("续传状态文件 {path} 说这份文件已经传完了 —— 要重传就删掉它，或去掉 --resume "
               "加 --force").format(path=state.path))
    in_tree = getattr(args, "in_tree", False)
    if in_tree:
        state.disabled = True     # 整棵目录里的单个文件不留续传状态：重跑一遍就是续传
    progress = Progress("↑ " + os.path.basename(local), total - resumed,
                        sys.stderr.isatty() and not args.quiet, silent=in_tree)

    def stats(**extra):
        fields = dict(started=started, bytes=state.completed - resumed, total=total,
                      parallel=workers, resumed=resumed)
        fields.update(extra)
        return transfer_stats("put", args, **fields)

    try:
        fd = os.open(local, os.O_RDONLY)
    except OSError as error:
        progress.finish(_("上传失败（local_read_failed）：{error}").format(error=error))
        return transfer_failure(
            {"code": "local_read_failed", "message": _("{path}：{error}").format(path=local, error=error)},
            stats())
    try:
        response = run_transfer(transfer_action(args, "put"), args, fd, state, workers, progress,
                                {"force": True if args.force else None})
    finally:
        os.close(fd)

    if not response.get("ok") and response.get("code") == "file_exists" and not state.done:
        # 根本没开始传：不留续传状态，也不提 --resume（接着传的前提是上一趟传了一半）。
        state.remove()
        progress.finish(_("上传失败（file_exists）：远端已存在 {path}，要覆盖请加 --force").format(path=args.path))
        return transfer_failure(response, stats())
    if not response.get("ok"):
        moved = state.completed - resumed
        incomplete = state.completed > 0
        progress.finish(_("上传失败（{code}）：已传 {moved} / {total}。{incomplete}{hint}").format(
            code=response.get("code"), moved=human(moved), total=human(total),
            incomplete=(_("远端 {path} 现在是**不完整**的文件；").format(path=args.path)
                        if incomplete else ""),
            hint=state.hint(args.path)))
        return transfer_failure(response, stats(
            incomplete=incomplete, resumable=state.armed and not state.disabled,
            statePath=state.path if state.armed else None))

    verdict = verify_pair(args, local, total)
    if state.note and verdict["note"] is None:
        verdict["note"] = state.note
    # 全部区间都成了：内容对不上是**内容**的问题，补区间补不回来，删掉状态文件整份重传。
    state.remove()
    return finish_transfer(_("上传"), args.path, progress, stats(
        bytes=total - resumed, sha256=verdict["sha256"], verified=verdict["verified"],
        verifyNote=verdict["note"]), verdict)


def do_get(args):
    local = os.path.expanduser(args.local)
    directory = os.path.dirname(os.path.abspath(local))
    if directory and not os.path.isdir(directory):
        fail(_("本地目录不存在：{path}").format(path=directory))
    if os.path.exists(local) and not (args.force or args.resume):
        fail(_("本地已存在 {path}；要覆盖请加 --force，要接着传请加 --resume").format(path=local))
    workers = parallel_for(args)
    started = time.time()
    # 成功之前绝不占用目标名：半截文件写在 `<目标>.part`，校验过了才 rename 过去。
    part = local + PART_SUFFIX

    stat, error = remote_stat(args, args.path)
    if error is not None:
        return transfer_failure(error, transfer_stats(
            "get", args, started=started, bytes=0, total=0, parallel=workers, resumed=0))
    size = int(stat.get("size") or 0)
    state = state_for("get", args, local, size, remote_identity(stat))
    resumed = state.completed
    if args.resume:
        if not os.path.exists(part):
            fail(_("续传状态文件 {path} 在，但半成品 {part} 不见了 —— 删掉状态文件重新下载").format(
                path=state.path, part=part))
        if not state.missing():
            fail(_("续传状态文件 {path} 说这份文件已经下完了 —— 要重下就删掉它，或去掉 --resume "
                   "加 --force").format(path=state.path))
    in_tree = getattr(args, "in_tree", False)
    if in_tree:
        state.disabled = True
    progress = Progress("↓ " + os.path.basename(local), size - resumed,
                        sys.stderr.isatty() and not args.quiet, silent=in_tree)

    def stats(**extra):
        fields = dict(started=started, bytes=state.completed - resumed, total=size,
                      parallel=workers, resumed=resumed)
        fields.update(extra)
        return transfer_stats("get", args, **fields)

    try:
        flags = os.O_RDWR | os.O_CREAT | (0 if args.resume else os.O_TRUNC)
        fd = os.open(part, flags, 0o644)
    except OSError as raised:
        progress.finish(_("下载失败（local_write_failed）：{error}").format(error=raised))
        return transfer_failure(
            {"code": "local_write_failed", "message": _("{path}：{error}").format(path=part, error=raised)},
            stats())
    try:
        response = run_transfer(transfer_action(args, "get"), args, fd, state, workers, progress, {})
    finally:
        os.close(fd)

    if not response.get("ok"):
        progress.finish(
            _("下载失败（{code}）：已收 {moved} / {total}。半成品在 {part}（目标 {target} 还没生成，内容**不完整**）；{hint}"
              ).format(code=response.get("code"), moved=human(state.completed - resumed), total=human(size),
                       part=part, target=local, hint=state.hint(part)))
        return transfer_failure(response, stats(
            incomplete=state.completed > 0, resumable=state.armed and not state.disabled,
            partPath=part, statePath=state.path if state.armed else None))

    strip_quarantine(part)
    verdict = verify_pair(args, part, size)
    if state.note and verdict["note"] is None:
        verdict["note"] = state.note
    state.remove()
    mismatched = verdict["remote"] is not None and not verdict["verified"]
    if not mismatched:
        try:
            os.replace(part, local)       # 校验过了才占用目标名
        except OSError as raised:
            progress.finish(_("下载失败（local_write_failed）：{error}").format(error=raised))
            return transfer_failure(
                {"code": "local_write_failed",
                 "message": _("把 {part} 改名成 {target} 失败：{error}").format(
                     part=part, target=local, error=raised)},
                stats(partPath=part))
    return finish_transfer(_("下载"), local, progress, stats(
        bytes=size - resumed, sha256=verdict["sha256"], verified=verdict["verified"],
        verifyNote=verdict["note"], partPath=part if mismatched else None), verdict)


def finish_transfer(verb, target, progress, stats, verdict):
    summary = _("{verb}完成：{moved} → {target}，{total}，{parallel} 路，{seconds}s，{speed} MiB/s").format(
        verb=verb, moved=human(stats["bytes"]), target=target, total=human(stats["totalBytes"]),
        parallel="%d" % stats["parallel"], seconds="%.1f" % stats["seconds"], speed="%.2f" % stats["mbps"])
    if stats["resumedFrom"]:
        summary += _("（从 {size} 续传）").format(size=human(stats["resumedFrom"]))
    if verdict["remote"] is not None and not verdict["verified"]:
        # 区间都传完了，内容却对不上 —— 补区间补不回来，只能整份重传。
        where = (_("半成品留在 {part}（目标名没生成）").format(part=stats["partPath"])
                 if stats.get("partPath") else _("远端是完整大小但内容不对"))
        progress.finish(summary + "\n" + (verdict["note"] or ""))
        return {
            "id": str(uuid.uuid4()), "ok": False, "code": "checksum_mismatch",
            "message": ((verdict["note"] or _("sha256 不一致"))
                        + _(" —— {where}；续传状态已清掉，整份重传（去掉 --resume，"
                            "目标已存在时加 --force）").format(where=where)),
            "transfer": stats,
        }
    if stats["verified"]:
        summary += _("，sha256 已校验")
    elif verdict["note"]:
        summary += _("，未校验：{note}").format(note=verdict["note"])
    progress.finish(summary)
    return {"id": str(uuid.uuid4()), "ok": True, "code": "ok",
            "message": summary, "transfer": stats}


# ---------------------------------------------------------------------------
# 配对过的 Mac（`macs` / `mac …`）
#
# 对象是 uTerm 里配对过的另一台 Mac，走远控链路（局域网、直连或中继），那台 Mac 不用开 SSH。
# 单文件的 get / put 复用上面的传输（fd 交给 uTerm、并行、续传、校验）；整个目录的
# get -r / put -r / sync 由这里编排：本地这一半只有客户端碰得到（uTerm 在沙盒里）。
# ---------------------------------------------------------------------------

# 一条请求上限 1 MiB：直接写进请求里的文本留出 JSON 转义的余量，再大就走 put。
MAX_INLINE_TEXT = 512 * 1024
TREE_WORKERS = 4


def inline_text(args, missing):
    """`mac write` / `mac patch` 的内容：--text、--file 或标准输入。"""
    text = getattr(args, "text", None)
    source = getattr(args, "source", None)
    if text is not None and source:
        fail(_("--text 与 --file 只能给一个"))
    if text is None:
        if source:
            try:
                with open(os.path.expanduser(source), "rb") as handle:
                    data = handle.read()
            except OSError as error:
                fail(_("读不了 {path}：{error}").format(path=source, error=error))
        elif not sys.stdin.isatty():
            data = sys.stdin.buffer.read()
        else:
            fail(missing)
        try:
            text = data.decode("utf-8")
        except UnicodeDecodeError:
            fail(_("内容不是 UTF-8 文本：二进制文件用 `mac put`"))
    if len(text.encode("utf-8")) > MAX_INLINE_TEXT:
        fail(_("内容超过 {size}：先写到本地文件，再用 `mac put` 传").format(size=human(MAX_INLINE_TEXT)))
    return text


def make_mac_request(args):
    leaf = args.mac_action
    mac = mac_target(args)
    request = {"id": str(uuid.uuid4()), "action": "mac-" + leaf, "mac": mac}

    options = []
    for name, option in (("hidden", "hidden"), ("no_ignore", "noIgnore"),
                         ("ignore_case", "ignoreCase"), ("fixed", "fixed"),
                         ("parents", "parents"), ("recursive", "recursive"),
                         ("all", "all"), ("dry_run", "dryRun"), ("hash", "hash")):
        if getattr(args, name, False) is True:
            options.append(option)
    kind = getattr(args, "type", None)
    if kind:
        options.append("files" if kind == "f" else "directories")
    if options:
        mac["options"] = options

    for field, key in (("path", "path"), ("new_path", "newPath"), ("mode", "mode"),
                       ("max_bytes", "maxBytes"), ("wait", "waitSeconds"),
                       ("timeout", "timeoutSeconds"), ("max_duration", "maxDurationSeconds"),
                       ("max_lines", "maxLines")):
        value = getattr(args, field, None)
        if value is not None and value != "":
            request[key] = value
    for field, key in (("include", "include"), ("exclude", "exclude"), ("limit", "limit"),
                       ("depth", "depth"), ("context", "context"), ("tail", "tail"),
                       ("offset", "offset"), ("length", "length"), ("if_match", "ifMatch"),
                       ("strip", "strip"), ("newer", "seconds")):
        value = getattr(args, field, None)
        if value is not None:
            mac[key] = value
    if getattr(args, "force", False):
        request["force"] = True

    if leaf == "grep":
        mac["pattern"] = args.pattern
    elif leaf == "find":
        if args.name:
            mac["pattern"] = args.name
    elif leaf == "read":
        picked = [x for x in (args.line_range, args.head, args.tail, args.offset) if x is not None]
        if len(picked) > 1:
            fail(_("--lines / --head / --tail / --offset 只能给一种"))
        if args.line_range:
            first, _sep, last = args.line_range.partition(":")
            try:
                mac["startLine"] = int(first) if first else 1
                if last:
                    mac["endLine"] = int(last)
            except ValueError:
                fail(_("--lines 要写成 A:B（如 120:180），实得 {value}").format(value=args.line_range))
        if args.head is not None:
            mac["startLine"], mac["endLine"] = 1, args.head
    elif leaf == "ln":
        request["newPath"] = args.target
    elif leaf == "write":
        request["text"] = inline_text(args, _("缺少要写的内容：用 --text、--file，或从标准输入给"))
    elif leaf == "edit":
        mac["oldText"], mac["newText"] = args.old, args.new
    elif leaf == "patch":
        request["text"] = inline_text(args, _("缺少补丁：用 --text、--file，或从标准输入给"))
    elif leaf == "xattr":
        mac["attributeAction"] = args.attribute_action
        if args.attribute:
            mac["attribute"] = args.attribute
        if args.attribute_action != "list" and not args.attribute:
            fail(_("xattr {action} 要给属性名").format(action=args.attribute_action))
        if args.attribute_action == "set":
            if args.value is None:
                fail(_("xattr set 要给值"))
            request["text"] = args.value
    elif leaf == "run":
        request["command"] = command_string(args)
        if args.cwd:
            request["path"] = args.cwd
    return request


def mac_call(args, action, mac=None, **fields):
    target = mac_target(args)
    target.update(mac or {})
    return send_with_retry(lambda previous: send_request(new_request(action, mac=target, **fields)))


def remote_join(root, relative):
    return root.rstrip("/") + "/" + relative if relative else root


def excluded(name, patterns):
    return any(fnmatch.fnmatch(name, pattern) for pattern in patterns or [])


def epoch_of(stamp):
    """ISO8601（`2026-11-11T08:00:00Z`）→ 距 1970 的整秒；读不懂回 None。"""
    if not stamp:
        return None
    try:
        return int(datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00")).timestamp())
    except ValueError:
        return None


def remote_tree(args, root, patterns):
    """逐层列一棵远端目录树。回 (目录相对路径列表, {文件相对路径: 条目}, 跳过的符号链接, 失败响应)。"""
    directories, files, links = [], {}, []
    queue = [""]
    while queue:
        relative = queue.pop(0)
        response = mac_call(args, "mac-ls", path=remote_join(root, relative))
        if not response.get("ok"):
            return None, None, None, response
        for entry in response.get("entries") or []:
            name = entry.get("name") or ""
            if name in ("", ".", "..") or excluded(name, patterns):
                continue
            child = relative + "/" + name if relative else name
            if entry.get("isSymlink"):
                links.append(child)
            elif entry.get("isDirectory"):
                directories.append(child)
                queue.append(child)
            else:
                files[child] = entry
    return directories, files, links, None


def local_tree(root, patterns):
    """回 (目录相对路径列表, {文件相对路径: os.stat_result}, 跳过的符号链接)。"""
    directories, files, links = [], {}, []
    for current, names, leaves in os.walk(root):
        names[:] = sorted(n for n in names if not excluded(n, patterns))
        base = os.path.relpath(current, root)
        base = "" if base == "." else base
        for name in list(names):
            child = os.path.join(base, name) if base else name
            if os.path.islink(os.path.join(current, name)):
                links.append(child)
                names.remove(name)
            else:
                directories.append(child)
        for name in sorted(leaves):
            if excluded(name, patterns):
                continue
            child = os.path.join(base, name) if base else name
            full = os.path.join(current, name)
            if os.path.islink(full):
                links.append(child)
            elif os.path.isfile(full):
                files[child] = os.stat(full)
    return directories, files, links


def transfer_one(args, direction, local, remote, force=True):
    """整棵目录里的一个文件。回 None（成了）或 {path, code, message}。"""
    one = argparse.Namespace(mac=args.mac, is_mac=True, host=None, path=remote, local=local, force=force,
                             resume=False, parallel=getattr(args, "parallel", DEFAULT_PARALLEL),
                             verify=False, quiet=True, in_tree=True)
    try:
        if direction == "down":
            os.makedirs(os.path.dirname(os.path.abspath(local)), exist_ok=True)
            response = do_get(one)
        else:
            response = do_put(one)
    except SystemExit:
        return {"code": "local_failure", "message": _("本地这边没法传（已存在且没给 --force，或读写不了）")}
    except BaseException as raised:      # noqa: BLE001
        return {"code": "local_failure", "message": "%s: %s" % (type(raised).__name__, raised)}
    if response.get("ok"):
        return None
    return {"code": response.get("code") or "operation_failed", "message": response.get("message") or ""}


def transfer_many(args, direction, jobs, label, after=None):
    """并行传一批文件。`jobs` 是 [(相对路径, 本地路径, 远端路径, 字节数)]。回 (成了的相对路径, 失败列表, 字节数)。"""
    force = getattr(args, "force", True)
    total = sum(job[3] for job in jobs)
    progress = Progress(label, total, sys.stderr.isatty() and not getattr(args, "quiet", False))
    lock = threading.Lock()
    done, failed, moved = [], [], [0]

    def work(job):
        relative, local, remote, size = job
        failure = transfer_one(args, direction, local, remote, force=force)
        if failure is None and after is not None:
            after(job)
        with lock:
            if failure is None:
                done.append(relative)
                moved[0] += size
            else:
                failure["path"] = relative
                failed.append(failure)
            progress.update(moved[0])

    if jobs:
        with concurrent.futures.ThreadPoolExecutor(max_workers=TREE_WORKERS) as pool:
            list(pool.map(work, jobs))
    progress.finish(None)
    return sorted(done), sorted(failed, key=lambda item: item["path"]), moved[0]


def tree_response(verb, summary, failed, **payload):
    payload["failed"] = failed
    ok = not failed
    message = summary if ok else summary + _("；{count} 个没成，见 failed").format(count=len(failed))
    sys.stderr.write(_("{verb}：{message}").format(verb=verb, message=message) + "\n")
    return {"id": str(uuid.uuid4()), "ok": ok, "code": "ok" if ok else "operation_failed",
            "message": message, "tree": payload}


def do_mac_tree(args, direction):
    """`mac get -r` / `mac put -r`。"""
    if args.resume:
        fail(_("整个目录不用 --resume：重跑一遍（加 --force）或用 `mac sync`，已经一样的文件不会重传"))
    local = os.path.abspath(os.path.expanduser(args.local))
    started = time.time()
    if direction == "down":
        if os.path.exists(local) and not os.path.isdir(local):
            fail(_("本地 {path} 不是目录").format(path=local))
        directories, files, links, error = remote_tree(args, args.path, None)
        if error is not None:
            return error
        os.makedirs(local, exist_ok=True)
        for relative in directories:
            os.makedirs(os.path.join(local, relative), exist_ok=True)
        jobs = [(relative, os.path.join(local, relative), remote_join(args.path, relative),
                 int(entry.get("size") or 0)) for relative, entry in sorted(files.items())]
    else:
        if not os.path.isdir(local):
            fail(_("本地目录不存在：{path}").format(path=local))
        directories, files, links = local_tree(local, None)
        for relative in [""] + directories:
            response = mac_call(args, "mac-mkdir", mac={"options": ["parents"]},
                                path=remote_join(args.path, relative))
            if not response.get("ok"):
                return response
        jobs = [(relative, os.path.join(local, relative), remote_join(args.path, relative), info.st_size)
                for relative, info in sorted(files.items())]
    done, failed, moved = transfer_many(args, direction, jobs,
                                        ("↓ " if direction == "down" else "↑ ") + os.path.basename(local))
    seconds = round(time.time() - started, 3)
    summary = _("{files} 个文件，{size}，{directories} 个目录，{seconds}s").format(
        files=len(done), size=human(moved), directories=len(directories), seconds="%.1f" % seconds)
    if links:
        summary += _("；跳过 {count} 个符号链接").format(count=len(links))
    return tree_response(_("下载完成") if direction == "down" else _("上传完成"), summary, failed,
                         localPath=local, remotePath=args.path, files=len(done), bytes=moved,
                         directories=len(directories), skippedLinks=links, seconds=seconds)


def do_mac_sync(args):
    """`mac sync up|down`：只传大小或修改时间不一样的文件，传完把修改时间对齐。"""
    local = os.path.abspath(os.path.expanduser(args.local))
    up = args.direction == "up"
    started = time.time()
    if up and not os.path.isdir(local):
        fail(_("本地目录不存在：{path}").format(path=local))
    if not up and os.path.exists(local) and not os.path.isdir(local):
        fail(_("本地 {path} 不是目录").format(path=local))

    local_dirs, local_files, local_links = local_tree(local, args.exclude) if os.path.isdir(local) else ([], {}, [])
    remote_dirs, remote_files, remote_links, error = remote_tree(args, args.path, args.exclude)
    if error is not None:
        if error.get("code") != "file_not_found" or not up:
            return error
        remote_dirs, remote_files, remote_links = [], {}, []    # 目标还不存在：整份传过去

    def remote_hash(relative):
        response = mac_call(args, "mac-hash", path=remote_join(args.path, relative))
        return ((response.get("mac") or {}).get("sha256") or "").lower() if response.get("ok") else None

    source = local_files if up else remote_files
    target = remote_files if up else local_files
    changed, unchanged, retime = [], 0, []
    for relative in sorted(source):
        local_info, remote_entry = local_files.get(relative), remote_files.get(relative)
        if relative not in target:
            changed.append(relative)
            continue
        if local_info.st_size != int(remote_entry.get("size") or 0):
            changed.append(relative)
            continue
        if int(local_info.st_mtime) == epoch_of(remote_entry.get("modifiedAt")):
            unchanged += 1
            continue
        if args.checksum and local_sha256(os.path.join(local, relative)) == remote_hash(relative):
            retime.append(relative)      # 内容一样，只是时间不同：对齐时间，不传
            unchanged += 1
            continue
        changed.append(relative)
    extra = sorted(set(target) - set(source)) if args.delete else []

    if args.dry_run:
        message = _("要传 {changed} 个文件，{unchanged} 个不用动").format(changed=len(changed), unchanged=unchanged)
        if extra:
            message += _("，要删 {count} 个").format(count=len(extra))
        return {"id": str(uuid.uuid4()), "ok": True, "code": "ok",
                "message": message + _("（--dry-run，没有动文件）"),
                "sync": {"direction": args.direction, "dryRun": True, "transfer": changed,
                         "delete": extra, "unchanged": unchanged}}

    def align(relative):
        """把目标的修改时间设成和源一样：下次同步靠它判断「没变」。"""
        if up:
            mac_call(args, "mac-touch", mac={"seconds": int(local_files[relative].st_mtime)},
                     path=remote_join(args.path, relative))
        else:
            stamp = epoch_of(remote_files[relative].get("modifiedAt"))
            if stamp is not None:
                os.utime(os.path.join(local, relative), (stamp, stamp))

    if up:
        for relative in [""] + local_dirs:
            response = mac_call(args, "mac-mkdir", mac={"options": ["parents"]},
                                path=remote_join(args.path, relative))
            if not response.get("ok"):
                return response
    else:
        os.makedirs(local, exist_ok=True)
        for relative in remote_dirs:
            os.makedirs(os.path.join(local, relative), exist_ok=True)

    def size_of(relative):
        return local_files[relative].st_size if up else int(remote_files[relative].get("size") or 0)

    jobs = [(relative, os.path.join(local, relative), remote_join(args.path, relative), size_of(relative))
            for relative in changed]
    args.force = True
    done, failed, moved = transfer_many(args, "up" if up else "down", jobs,
                                        ("↑ " if up else "↓ ") + os.path.basename(local),
                                        after=lambda job: align(job[0]))
    for relative in retime:
        align(relative)

    deleted = []
    for relative in extra:
        if up:
            response = mac_call(args, "mac-trash", path=remote_join(args.path, relative))
            if response.get("ok"):
                deleted.append(relative)
            else:
                failed.append({"path": relative, "code": response.get("code"), "message": response.get("message")})
        else:
            try:
                os.remove(os.path.join(local, relative))
                deleted.append(relative)
            except OSError as raised:
                failed.append({"path": relative, "code": "local_write_failed", "message": str(raised)})

    seconds = round(time.time() - started, 3)
    summary = _("传了 {files} 个文件（{size}），{unchanged} 个没变").format(
        files=len(done), size=human(moved), unchanged=unchanged)
    if deleted:
        summary += (_("，删了 {count} 个（在那台 Mac 的废纸篓里）") if up
                    else _("，删了 {count} 个")).format(count=len(deleted))
    links = local_links if up else remote_links
    if links:
        summary += _("；跳过 {count} 个符号链接").format(count=len(links))
    ok = not failed
    message = summary if ok else summary + _("；{count} 个没成，见 failed").format(count=len(failed))
    sys.stderr.write(_("同步完成：{message}").format(message=message) + "\n")
    return {"id": str(uuid.uuid4()), "ok": ok, "code": "ok" if ok else "operation_failed", "message": message,
            "sync": {"direction": args.direction, "dryRun": False, "transferred": done, "deleted": deleted,
                     "unchanged": unchanged, "bytes": moved, "failed": failed, "skippedLinks": links,
                     "seconds": seconds}}


MAC_COLUMNS = ["name", "role", "current", "onLocalNetwork", "onRelay", "connected", "path", "supportsFiles", "id"]


def mac_output(response, fmt, action):
    """`macs` / `mac …` 的人类可读输出；回 None 表示交给通用的表格逻辑。"""
    mac = response.get("mac") or {}
    if action == "macs":
        rows = [[cell(item.get(c)) for c in MAC_COLUMNS] for item in mac.get("macs") or []]
        if not rows:
            return response.get("message") or _("没有配对过的 Mac")
        return render_table(MAC_COLUMNS, rows) if fmt == "table" else render_csv(MAC_COLUMNS, rows)
    if action == "mac-run":
        return run_output(response)
    if action == "mac-shares":
        roots = mac.get("roots")
        if not roots:
            return response.get("message") or ""
        rows = [[item.get("path", ""), _("读写") if item.get("writable") else _("只读")] for item in roots]
        return render_table(["path", "access"], rows) if fmt == "table" else render_csv(["path", "access"], rows)
    payload = response.get("file")
    if isinstance(payload, dict):
        if payload.get("text") is not None:
            return payload["text"]
        return _("-- {path} 不是 UTF-8 文本（{bytes} 字节）：用 `mac get` 下载后本地处理").format(
            path=payload.get("path", "?"), bytes=payload.get("bytes", "?"))
    if action == "mac-grep":
        matches = mac.get("matches") or []
        if fmt == "csv":
            return render_csv(["path", "line", "text"],
                              [[m.get("path", ""), str(m.get("line", "")), m.get("text", "")] for m in matches])
        lines = []
        for m in matches:
            first = m.get("line", 0) - len(m.get("before") or [])
            for offset, text in enumerate(m.get("before") or []):
                lines.append("%s-%d- %s" % (m.get("path"), first + offset, text))
            lines.append("%s:%d: %s" % (m.get("path"), m.get("line", 0), m.get("text", "")))
            for offset, text in enumerate(m.get("after") or []):
                lines.append("%s-%d- %s" % (m.get("path"), m.get("line", 0) + 1 + offset, text))
            if m.get("before") or m.get("after"):
                lines.append("--")
        lines.append("-- " + (response.get("message") or ""))
        return "\n".join(lines)
    if action == "mac-find":
        header = ["path", "kind", "size", "modifiedAt"]
        found = mac.get("found") or []
        if any(item.get("sha256") for item in found):
            header.append("sha256")
        rows = [[cell(item.get("path")), "dir" if item.get("isDirectory") else "file", cell(item.get("size")),
                 cell(item.get("modifiedAt"))] + ([cell(item.get("sha256"))] if "sha256" in header else [])
                for item in found]
        if not rows:
            return response.get("message") or ""
        body = render_table(header, rows, limit=200) if fmt == "table" else render_csv(header, rows)
        return body + ("\n-- " + response.get("message", "") if mac.get("truncated") else "")
    if action in ("mac-ls", "mac-stat"):
        return None
    if mac.get("text") is not None and action in ("mac-read", "mac-tree", "mac-patch", "mac-xattr"):
        body = mac["text"].rstrip("\n")
        if action == "mac-read" or mac.get("truncated"):
            body += "\n-- " + (response.get("message") or "")
        return body
    if action == "mac-xattr" and mac.get("names") is not None:
        return "\n".join(mac["names"]) or _("（没有扩展属性）")
    if action == "mac-wait-change" and mac.get("names"):
        return "\n".join(mac["names"]) + "\n-- " + (response.get("message") or "")
    if action in ("mac-get", "mac-put", "mac-sync"):
        return as_json(response)
    return response.get("message") or as_json(response)


TRANSFER_COLUMNS = ["action", "localPath", "remotePath", "bytes", "totalBytes",
                    "parallel", "seconds", "mbps", "resumedFrom",
                    "sha256", "verified", "verifyNote",
                    "incomplete", "resumable", "statePath", "partPath"]


def render_transfer(response, fmt):
    # 失败响应一律原样打 JSON —— 与别的动作一致，模型要读 code / hostKey。
    if fmt == "json" or not response.get("ok"):
        return as_json(response)
    transfer = response.get("transfer") or {}
    header = [_("字段"), _("值")]
    rows = [[key, cell(transfer.get(key))] for key in TRANSFER_COLUMNS]
    return render_table(header, rows) if fmt == "table" else render_csv(header, rows)


def cell(value):
    if value is None:
        return "-"
    if isinstance(value, bool):
        # false 必须画成「否」而不是空白：空白与「字段缺失」（"-"）分不开，
        # hosts 的 sftpOnly / cliConnected、terminals 的 isKeyWindowFocused、
        # forward list 的 autostart 在表格里本来整列都是空的。
        return _("是") if value else _("否")
    if isinstance(value, (dict, list)):
        return json.dumps(value, ensure_ascii=False, sort_keys=True)
    return str(value)


def octal(value):
    if value is None:
        return "-"
    try:
        return format(int(value) & 0o7777, "04o")
    except (TypeError, ValueError):
        return str(value)


TABLES = [
    ("hosts", ["name", "host", "port", "username", "authMethod", "group", "jumpHost",
               "sftpOnly", "cliConnected", "activeForwards", "id"]),
    ("rules", ["name", "serverName", "kind", "listenHost", "listenPort", "destHost",
               "destPort", "status", "autostart", "bytesIn", "bytesOut", "id"]),
    ("terminals", ["title", "serverName", "windowKind", "isKeyWindowFocused",
                   "connectedAt", "id"]),
    ("quickCommands", ["name", "command", "serverNames", "lastRunAt", "id"]),
    ("results", ["host", "exitCode", "timedOut", "truncated", "durationMs",
                 "errorCode", "errorMessage"]),
]


def rows_of(response):
    """把响应里可表格化的部分取成 (表头, 行) —— 没有就返回 None。"""
    entries = response.get("entries")
    if isinstance(entries, list):
        header = ["name", "kind", "size", "mode", "owner", "group", "modifiedAt"]
        rows = []
        for item in entries:
            kind = "dir" if item.get("isDirectory") else ("link" if item.get("isSymlink") else "file")
            rows.append([
                cell(item.get("name")), kind, cell(item.get("size")),
                octal(item.get("permissions")), cell(item.get("ownerName")),
                cell(item.get("groupName")), cell(item.get("modifiedAt")),
            ])
        return header, rows
    for key, columns in TABLES:
        items = response.get(key)
        if isinstance(items, list):
            return columns, [[cell(item.get(c)) for c in columns] for item in items]
    result = response.get("result")
    if isinstance(result, dict):
        columns = dict(TABLES)["results"]
        return columns, [[cell(result.get(c)) for c in columns]]
    stat = response.get("stat")
    if isinstance(stat, dict):
        # mode 与 ls 一样按 & 0o7777 的八进制显示（原始值含类型位，类型另立 kind 列）。
        header = ["path", "kind", "size", "mode", "modifiedAt"]
        row = [cell(stat.get("path")), cell(stat.get("kind")), cell(stat.get("size")),
               octal(stat.get("permissions")), cell(stat.get("modifiedAt"))]
        return header, [row]
    return None


def render_table(header, rows, limit=60):
    widths = [len(h) for h in header]
    clipped = []
    for row in rows:
        cells = []
        for index, value in enumerate(row):
            text = value.replace("\n", " ")
            if len(text) > limit:
                text = text[: limit - 1] + "…"
            cells.append(text)
            widths[index] = max(widths[index], len(text))
        clipped.append(cells)
    lines = ["  ".join(h.ljust(widths[i]) for i, h in enumerate(header)).rstrip()]
    lines.append("  ".join("-" * widths[i] for i in range(len(header))))
    for row in clipped:
        lines.append("  ".join(row[i].ljust(widths[i]) for i in range(len(header))).rstrip())
    return "\n".join(lines)


def render_csv(header, rows):
    buffer = io.StringIO()
    writer = csv.writer(buffer)
    writer.writerow(header)
    writer.writerows(rows)
    return buffer.getvalue().rstrip("\n")


def as_json(response):
    return json.dumps(response, ensure_ascii=False, indent=2, sort_keys=True)


def run_output(response):
    """run / run-many 的人类可读输出：逐主机一段，带退出码与超时提醒。"""
    results = response.get("results")
    if not isinstance(results, list):
        single = response.get("result")
        results = [single] if isinstance(single, dict) else []
    blocks = []
    for item in results:
        head = "── %s" % item.get("host", "?")
        if item.get("exitCode") is not None:
            head += "  exit=%s" % item["exitCode"]
        head += "  %sms" % item.get("durationMs", 0)
        if item.get("errorCode"):
            head += "  [%s] %s" % (item["errorCode"], item.get("errorMessage") or "")
        blocks.append(head)
        body = item.get("output") or ""
        if body:
            blocks.append(body.rstrip("\n"))
        if item.get("truncated"):
            blocks.append(_("-- 输出已截断（--max-lines / --max-bytes 可放宽）"))
        if item.get("timedOut"):
            blocks.append(_("-- 已超时；**命令可能还在远端继续跑**"))
    return "\n".join(blocks)


def terminal_run_output(response):
    """terminal open -- <命令> / terminal wait 的人类可读输出：命令的输出，末尾一行状态。"""
    run = response.get("run") or {}
    parts = []
    if run.get("output"):
        parts.append(run["output"])
    if run.get("truncated"):
        parts.append(_("-- 输出太长，只给了最后一段"))
    state = run.get("state", "?")
    if run.get("exitCode") is not None:
        state += "  exit=%s" % run["exitCode"]
    parts.append("-- [%s] %s" % (str(run.get("terminal", "?"))[:8], state))
    if response.get("message"):
        parts.append("-- " + response["message"])
    return "\n".join(parts)


# 这两个码的响应带着完整的 results，人类可读格式照常逐主机渲染。
RUN_BATCH_CODES = ("run_failed", "run_partial_failure")


RELAY_FIELDS = ["name", "endpoint", "relayID", "managedHost", "internetEnabled", "registered",
                "latestVersion", "updateAvailable"]
RELAY_CHECK_FIELDS = ["tcp", "auth", "udp", "rttMs", "serverVersion", "onlineHosts", "mappedAddress"]


def relay_output(response, fmt):
    relay = response.get("relay") or {}
    check = relay.get("check") or {}
    rows = [[key, cell(relay.get(key))] for key in RELAY_FIELDS]
    rows += [["check." + key, cell(check.get(key))] for key in RELAY_CHECK_FIELDS if check]
    header = [_("字段"), _("值")]
    table = render_table(header, rows) if fmt == "table" else render_csv(header, rows)
    return (response.get("message") or "") + "\n\n" + table


def render(response, fmt, args):
    if not response.get("ok"):
        # run-many / quick-run 失败时 results 才是有用的东西（逐台的 errorCode），
        # 一股脑打 JSON 等于把表格吞了。json 格式仍然原样输出。
        if (fmt != "json" and response.get("code") in RUN_BATCH_CODES
                and isinstance(response.get("results"), list)):
            return run_output(response) + "\n-- " + (response.get("message") or "")
        return as_json(response)
    action = resolved_action(args)

    # 结果就是一行 shell 命令：原样打印，好直接交给 `run -H <主机> -- …` / `terminal open`。
    if action == "relay-install-command":
        return response.get("message") or ""

    if fmt == "json":
        return as_json(response)

    if action == "macs" or action.startswith("mac-"):
        text = mac_output(response, fmt, action)
        if text is not None:
            return text

    if action == "sftp-cat":
        payload = response.get("file") or {}
        if payload.get("text") is not None:
            body = payload["text"]
            if payload.get("truncated"):
                body += _("\n-- 内容不完整：读取期间远端文件变大了")
            return body
        return _("-- {path} 不是 UTF-8 文本（{bytes} 字节）：用 `sftp get` 下载后本地处理").format(
            path=payload.get("path", "?"), bytes=payload.get("bytes", "?"))

    run = response.get("run")
    if isinstance(run, dict):
        return terminal_run_output(response)

    screen = response.get("screen")
    if isinstance(screen, dict):
        body = "\n".join(screen.get("lines") or [])
        if screen.get("truncated"):
            body += _("\n-- 读屏已截断")
        return body

    if action in ("run", "run-many", "quick-run"):
        return run_output(response)

    relay = response.get("relay")
    if isinstance(relay, dict):
        return relay_output(response, fmt)

    table = rows_of(response)
    if table is None:
        return as_json(response)
    header, rows = table
    # 空表就打服务端的说明。`terminal open` 会在窗口开了、但 6 秒内会话还没注册上来
    # 时回 `terminals: []` + 一句解释，只印表头等于把这句话吞了。
    if not rows:
        return response.get("message") or as_json(response)
    return render_table(header, rows) if fmt == "table" else render_csv(header, rows)


def main():
    args = build_parser().parse_args()
    fmt = getattr(args, "format", "json")
    action = resolved_action(args)
    # 传输要打开本地文件、交 fd、收进度、续传、校验，自己走一条路；其余动作一请求一响应。
    if action == "mac-sync" or (action in ("mac-put", "mac-get") and args.recursive):
        try:
            if action == "mac-sync":
                parallel_for(args)
                response = do_mac_sync(args)
            else:
                response = do_mac_tree(args, "down" if action == "mac-get" else "up")
        except SystemExit:
            raise
        except BaseException as raised:      # noqa: BLE001
            response = {"id": None, "ok": False, "code": "local_failure",
                        "message": "%s: %s" % (type(raised).__name__, raised)}
        print(as_json(response))
        return exit_code_for(response)
    if action in ("sftp-put", "sftp-get", "mac-put", "mac-get"):
        try:
            response = do_put(args) if action.endswith("-put") else do_get(args)
        except SystemExit:
            raise                     # `fail()` 的本地拒绝：消息已经在 stderr 上了
        except BaseException as raised:      # noqa: BLE001
            # 传输路径绝不能吐 traceback：调用方（模型 / 脚本）读的是 JSON + 退出码。
            response = {"id": None, "ok": False, "code": "local_failure",
                        "message": "%s: %s" % (type(raised).__name__, raised)}
        print(render_transfer(response, fmt))
        return exit_code_for(response)
    request = make_mac_request(args) if action.startswith("mac-") else make_request(args)
    response = send_request(request)
    print(render(response, fmt, args))
    return exit_code_for(response)


if __name__ == "__main__":
    sys.exit(main())
