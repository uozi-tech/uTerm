+// Takes and returns linear Display P3 colors (see load_color).
+float4 contrasted_color(float min_ratio, float4 fg, float4 bg) {
+  float3 fg_srgb = clamp(DP3_sRGB * fg.rgb, 0.0f, 1.0f);
+  float3 bg_srgb = clamp(DP3_sRGB * bg.rgb, 0.0f, 1.0f);
+  float fg_y = luminance(fg_srgb);
+  float bg_y = luminance(bg_srgb);
+  if ((max(fg_y, bg_y) + 0.05f) / (min(fg_y, bg_y) + 0.05f) >= min_ratio) return fg;
+
+  float3 base = uterm_oklch(fg_srgb);
+  bool prefer_lighten = bg_y < 0.5f;
+  float4 best = uterm_attempt(base, bg_y, min_ratio, prefer_lighten);
+  if (best.w < min_ratio - 0.01f) {
+    float4 opposite = uterm_attempt(base, bg_y, min_ratio, !prefer_lighten);
+    if (opposite.w > best.w) best = opposite;
+  }
+  return float4(srgb_to_display_p3(best.rgb), fg.a);
 }
 
