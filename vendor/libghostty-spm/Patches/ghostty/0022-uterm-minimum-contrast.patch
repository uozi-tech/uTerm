+// Upstream jumps to white or black, which bleaches a colored prompt segment.
+// This is uTerm's algorithm (vendor/SwiftTerm .../MinimumContrast.swift,
+// TerminalContrast.ensureContrast), ported 1:1:
+//
+//   - WCAG 2.x luminance and contrast ratio, in linear sRGB;
+//   - the direction keys off the background (lighten on bg luminance < 0.5,
+//     darken otherwise), the opposite direction is tried when the preferred
+//     one cannot reach the ratio and the better result wins;
+//   - the adjustment walks OKLCH lightness toward the pole with the hue
+//     fixed and chroma capped by the original and the sRGB gamut, bisecting
+//     (18 steps) for the smallest move that reaches the WCAG target.
+//
+// The colors arrive as linear Display P3 (load_color converts sRGB input,
+// and the output is always Display P3), so they are taken back to linear
+// sRGB with the inverse of sRGB_DP3 first and the result is converted again.
+// This runs per vertex, and only for glyphs below the ratio.
+
+// Inverse of sRGB_DP3 (computed from the two matrices above).
+constant float3x3 DP3_sRGB = transpose(float3x3(
+   1.224800825f, -0.224665879f, -0.000045539f,
+  -0.042027144f,  1.041954490f,  0.000081859f,
+  -0.019719504f, -0.078620103f,  1.097902547f
+));
+
+float uterm_cbrt(float v) {
+  return v < 0.0f ? -pow(-v, 1.0f / 3.0f) : pow(v, 1.0f / 3.0f);
+}
+
+// linear sRGB -> OKLCH (L, C, h in radians)
+float3 uterm_oklch(float3 c) {
+  float l = 0.4122214708f * c.r + 0.5363325363f * c.g + 0.0514459929f * c.b;
+  float m = 0.2119034982f * c.r + 0.6806995451f * c.g + 0.1073969566f * c.b;
+  float s = 0.0883024619f * c.r + 0.2817188376f * c.g + 0.6299787005f * c.b;
+  float l3 = uterm_cbrt(l), m3 = uterm_cbrt(m), s3 = uterm_cbrt(s);
+  float L = 0.2104542553f * l3 + 0.7936177850f * m3 - 0.0040720468f * s3;
+  float a = 1.9779984951f * l3 - 2.4285922050f * m3 + 0.4505937099f * s3;
+  float b = 0.0259040371f * l3 + 0.7827717662f * m3 - 0.8086757660f * s3;
+  return float3(L, sqrt(a * a + b * b), atan2(b, a));
+}
+
+// OKLCH -> linear sRGB, unclamped.
+float3 uterm_linear_srgb(float L, float C, float h) {
+  float a = C * cos(h);
+  float b = C * sin(h);
+  float l3 = L + 0.3963377774f * a + 0.2158037573f * b;
+  float m3 = L - 0.1055613458f * a - 0.0638541728f * b;
+  float s3 = L - 0.0894841775f * a - 1.2914855480f * b;
+  float l = l3 * l3 * l3, m = m3 * m3 * m3, s = s3 * s3 * s3;
+  return float3(
+    4.0767416621f * l - 3.3077115913f * m + 0.2309699292f * s,
+    -1.2684380046f * l + 2.6097574011f * m - 0.3413193965f * s,
+    -0.0041960863f * l - 0.7034186147f * m + 1.7076147010f * s
+  );
+}
+
+bool uterm_in_gamut(float3 c) {
+  const float eps = 0.0005f;
+  return all(c >= -eps) && all(c <= 1.0f + eps);
+}
+
+// (L, h) with the largest chroma <= max_c inside the sRGB gamut, clamped.
+float3 uterm_fit_chroma(float L, float h, float max_c) {
+  float3 rgb = uterm_linear_srgb(L, max_c, h);
+  if (!uterm_in_gamut(rgb)) {
+    float lo = 0.0f, hi = max_c;
+    for (int i = 0; i < 12; i++) {
+      float mid = (lo + hi) * 0.5f;
+      if (uterm_in_gamut(uterm_linear_srgb(L, mid, h))) lo = mid; else hi = mid;
+    }
+    rgb = uterm_linear_srgb(L, lo, h);
+  }
+  return clamp(rgb, 0.0f, 1.0f);
+}
+
+bool uterm_on_target_side(float y, float target, bool lighten) {
+  return lighten ? y >= target : y <= target;
+}
+
+// One direction: rgb (linear sRGB) and the contrast it achieves in .w.
+float4 uterm_attempt(float3 base, float bg_y, float ratio, bool lighten) {
+  float target = lighten ? min(ratio * (bg_y + 0.05f) - 0.05f, 1.0f)
+                         : max((bg_y + 0.05f) / ratio - 0.05f, 0.0f);
+  float pole = lighten ? 1.0f : 0.0f;
+  float lo = 0.0f, hi = 1.0f;
+  float3 end = uterm_fit_chroma(base.x + (pole - base.x), base.z, base.y);
+  if (uterm_on_target_side(luminance(end), target, lighten)) {
+    for (int i = 0; i < 18; i++) {
+      float mid = (lo + hi) * 0.5f;
+      float3 rgb = uterm_fit_chroma(base.x + (pole - base.x) * mid, base.z, base.y);
+      if (uterm_on_target_side(luminance(rgb), target, lighten)) hi = mid; else lo = mid;
     }
   }
+  float3 rgb = uterm_fit_chroma(base.x + (pole - base.x) * hi, base.z, base.y);
+  float y = luminance(rgb);
+  return float4(rgb, (max(y, bg_y) + 0.05f) / (min(y, bg_y) + 0.05f));
+}
 
