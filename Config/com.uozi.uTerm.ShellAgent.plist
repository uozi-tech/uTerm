<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  本机 shell 辅助进程（uTermShellAgent）的 launchd 配置。构建时由 uTerm target 的
  「Embed Shell Agent」阶段拷到 Contents/Library/LaunchAgents/，主程序用
  SMAppService.agent(plistName:) 注册；BundleProgram 是相对 app 包的路径。
  只按需启动：主程序连 MachServices 里的名字时 launchd 才拉起它，空闲一分钟后它自己退出。
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.uozi.uTerm.ShellAgent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/uTermShellAgent</string>
	<key>MachServices</key>
	<dict>
		<key>com.uozi.uTerm.ShellAgent</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.uozi.uTerm</string>
	</array>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
