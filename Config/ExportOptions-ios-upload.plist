<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	uTermMobile 上传 App Store Connect / TestFlight 的导出选项。
	与 ExportOptions-ios.plist 只差一个键：destination = upload
	（xcodebuild -exportArchive 直接把 .ipa 交给 App Store Connect，不落盘）。
	改一份时记得两份同步。

	用于 `make upload-mobile`。认证优先用 .env 里的 App Store Connect API key
	（ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH），未配置时回退到 Xcode 已登录的
	Apple ID。manageAppVersionAndBuildNumber = false 的原因见 ExportOptions-ios.plist。
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>ABCDE12345</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>upload</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
