// 唯一真值源：uTermMobile 的用户可见版本号 (main.feat.patch)。
// 由 scripts/bump-version.sh / make bump-*-mobile / make set-version-mobile 维护。
// uTermMobile 与 uTermMobileTests 的 **target 级** baseConfigurationReference 引用本文件，
// 叠在 project 级的 Config/Version.xcconfig 之上，覆盖掉 macOS 那份 MARKETING_VERSION。
// iOS 与 macOS 的版本号各自独立递增（两个商店互不相干），不要合回一份。
MARKETING_VERSION = 1.1.2
