// 本机构建覆盖：复制成 Config/Local.xcconfig（已 gitignore）再改。被 Config/Version.xcconfig 末尾 `#include?` 读入。
//
// 签名：填你自己的 Apple Developer Team ID（Xcode → Settings → Accounts 里能看到）。
// 进程间互认（远控进程、本机终端的辅助进程、holder）按「同一团队签名」判断，团队号从签名里读，不用另外配。
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// 可选：应用内更新与中继一键部署。不填就没有这两个功能（各自的入口自动隐藏）。
// URL 里的 `//` 要写成 `/$()/`，否则会被当成注释。
// UTERM_SU_FEED_URL = https:/$()/example.com/uTerm/appcast.xml
// UTERM_SU_PUBLIC_ED_KEY = <Sparkle EdDSA 公钥>
// UTERM_RELAY_RELEASE_URL = https:/$()/example.com/uTerm/relay
