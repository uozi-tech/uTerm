<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  本机 shell 辅助程序（uTermShellAgent.xpc）的 Info.plist 补充项，其余键由 GENERATE_INFOPLIST_FILE 生成。
  它是 uTerm 内嵌的 XPC 服务（Contents/XPCServices/），主程序连接时由系统按需拉起、主程序退出时一起结束；
  不带沙盒——这正是它存在的理由。沙盒主程序不能用 SMAppService 注册不带沙盒的 LaunchAgent
  （macOS 14.2 起后台任务管理直接拒绝，报 Operation not permitted），内嵌 XPC 服务没有这条限制
  （Sparkle 的安装器服务同理）。
-->
<plist version="1.0">
<dict>
	<key>XPCService</key>
	<dict>
		<key>ServiceType</key>
		<string>Application</string>
		<!-- 默认每个 XPC 服务进新的安全会话，从这里起的 shell 读钥匙串报 errSecInteractionNotAllowed（退出码 36），
		     claude、gh 这类把凭据存钥匙串的命令因此显示未登录。加入主程序的会话，才和系统终端一样。 -->
		<key>JoinExistingSession</key>
		<true/>
	</dict>
	<key>UTermBundleIDBase</key>
	<string>$(UTERM_BUNDLE_ID)</string>
</dict>
</plist>
