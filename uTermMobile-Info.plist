<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.uozi.uTerm.relay</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>uterm</string>
			</array>
		</dict>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>uTerm 使用局域网发现 Mac，用于同步设置，以及远程控制 Mac 上的终端和屏幕。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_uterm-sync._tcp</string>
		<string>_uterm-remote._tcp</string>
		<string>_uterm-group._tcp</string>
	</array>
	<!-- 出口合规声明（App Store Connect / TestFlight 每次上传都会问一遍；
	     声明在 Info.plist 里 App Store Connect 就不再弹窗，构建也不会卡在「缺少合规信息」）。

	     依据：uTerm 客户端只用 Apple 平台自带与开源标准实现的密码学
	     （swift-crypto / CryptoKit、swift-nio-ssh 的 SSH 传输层、Keychain），
	     没有自研或私有算法，属于美国出口管制 EAR 15 CFR 740.17(b) 里
	     「使用标准/公开算法的免除类」——即 Apple 问卷中的 (b) 类豁免，
	     因此 ITSAppUsesNonExemptEncryption = NO。

	     ⚠️ 这是一条法律声明，不是技术开关。两点须知：
	     1) 引入自研加密、私有算法或非标准密码学实现时，本值必须改回 YES 并重新走问卷；
	     2) 即便声明豁免，仍需每年向 BIS/ENC 自行提交一次 self-classification report。
	     拿不准时以法务/合规意见为准，不要以本注释为最终依据。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- iPhone 上不加这个键，Core Animation（含 CADisplayLink 的 120 请求）封顶 60 Hz，
	     ProMotion 机型看远程桌面也只有 60 帧。iPad 不需要它。 -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>uTerm 使用相机扫描 Mac 上显示的配对二维码。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>uTerm 使用面容 ID 解锁应用，并在远程解锁 Mac 时取用你保存的登录密码。</string>
	<!-- 只声明真正用到的后台模式。`remote-notification` 是 SwiftData 的 CloudKit 镜像
	     （NSPersistentCloudKitContainer）接静默推送所必需，见 MobileApp.swift 的
	     MobileAppDelegate 注释。

	     ⚠️ 不要顺手加 `processing` / `fetch`：全仓没有任何 BGTaskScheduler /
	     BGProcessingTaskRequest / BGAppRefreshTaskRequest / performFetch 实现，
	     声明了却不用会被 App Store Connect 以 ITMS-90771 拒收。 -->
	<!-- 工作区标签拖拽（拖到边上分屏 / 拖进另一格）的应用内载荷类型，与 macOS 的 Info.plist
	     同一个标识。`UTType(exportedAs:)` 要求在这里登记；载荷注册成 `.ownProcess`，
	     拖不出本 app，也不会被当成文本落进输入框。 -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.uozi.uterm.tab-id</string>
			<key>UTTypeDescription</key>
			<string>uTerm tab drag identifier</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<!-- 后台刷新：经中继续成员证书的补充（RemoteMacDirectoryLifecycle，系统不保证执行）。 -->
		<string>fetch</string>
	</array>
	<!-- 并行执行切到别的 App 后继续跑：iOS 26 的 BGContinuedProcessingTask（用户点「运行」时
	     在前台提交，系统在锁屏 / 灵动岛显示进度）。见 Screens/Parallel/ParallelRunSessions.swift
	     的 ParallelBackgroundKeeper。每次提交用一个新后缀，所以这里登记通配符。
	     这类任务不需要 UIBackgroundModes 里的 processing。 -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.uozi.uTerm.parallel.*</string>
		<string>com.uozi.uTerm.relay.renewCertificates</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>SplashLaunchBackground</string>
	</dict>
</dict>
</plist>
