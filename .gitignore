# 内部资料（真实地址、发版配置；将来是单独的私有仓库），永不进公开仓库
/internal/
.claude/worktrees/
# typo guard for .claude/worktrees/ — earlier runs leaked into .claire/
.claire/
# leaked worktree clone dir from earlier runs
.clone/

# Swift coverage instrumentation output
*.profraw

# vendored 包的本地构建产物
vendor/tree-sitter-grammars/.build/
vendor/tree-sitter-grammars/.swiftpm/
vendor/swift-nio-ssh/.build/
vendor/swift-nio-ssh/.swiftpm/
vendor/Citadel/.build/
vendor/Citadel/.swiftpm/
vendor/libghostty-spm/.build/
vendor/libghostty-spm/.swiftpm/

# 终端引擎的二进制不进版本库：make engine 按 vendor/libghostty-spm/ENGINE.lock 取、校验、解到这里
vendor/libghostty-spm/BinaryTarget/*.xcframework
vendor/libghostty-spm/BinaryTarget/*.stamp
vendor/libghostty-spm/BinaryTarget/.fetch.*

# Release credentials (never commit)
.env

# Release build artifacts
build/

# SPM 构建产物（任意包，含 Packages/*/.build）
.build/

# Xcode/SwiftPM per-user 状态
xcuserdata/

# 主机上的会话保持进程的二进制不进版本库：make holder 从 holder/ 编出来放到这里
uTerm/Services/SSH/HostHolder/Binaries/
